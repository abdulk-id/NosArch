{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/abdulk-id/NosArch/master/config.schema.json",
    "title": "NosArch Config",
    "description": "Configuration schema for NosArch",
    "type": "object",
    "properties": {
        "user": {
            "type": "object",
            "properties": {
                "username": {
                    "type": "string",
                    "description": "User name"
                },
                "fullname": {
                    "type": "string",
                    "description": "User's full name"
                },
                "git_email": {
                    "type": "string",
                    "description": "User's Git email",
                    "default": ""
                }
            },
            "required": ["username", "fullname"]
        },
        "setups": {
            "type": "object",
            "properties": {
                "basic": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable Basic Setup",
                            "default": false
                        },
                        "enable_virtualization": {
                            "type": "boolean",
                            "description": "Setup NosArch for running Virtual Machines",
                            "default": false
                        }
                    }
                },
                "ai": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Setup NosArch for AI and Agentic work",
                            "default": false
                        },
                        "agents": {
                            "type": "array",
                            "description": "List of AI agents to install",
                            "items": {
                                "type": "string",
                                "anyOf": [
                                    { "const": "antigravity-cli", "title": "Antigravity CLI" },
                                    { "const": "claude-code", "title": "Claude Code" },
                                    { "const": "codex", "title": "OpenAI Codex" },
                                    { "const": "copilot-cli", "title": "GitHub Copilot CLI" },
                                    { "const": "crush", "title": "Crush" },
                                    { "const": "cursor-cli", "title": "Cursor CLI" },
                                    { "const": "devin-cli", "title": "Devin CLI" },
                                    { "const": "gemini-cli", "title": "Gemini CLI" },
                                    { "const": "grok-build", "title": "Grok Build" },
                                    { "const": "kilocode", "title": "Kilo Code" },
                                    { "const": "mimocode", "title": "MiMo-Code" },
                                    { "const": "muse-code", "title": "Muse Code" },
                                    { "const": "omp", "title": "Oh My Pi" },
                                    { "const": "opencode", "title": "OpenCode" },
                                    { "const": "pi", "title": "Pi" }
                                ]
                            },
                            "uniqueItems": true,
                            "default": []
                        },
                        "apps": {
                            "type": "array",
                            "description": "List of AI apps to install",
                            "items": {
                                "type": "string",
                                "anyOf": [
                                    { "const": "chatgpt-desktop", "title": "ChatGPT Desktop" },
                                    { "const": "claude-desktop", "title": "Claude Desktop" },
                                    { "const": "cursor-desktop", "title": "Cursor Desktop" },
                                    { "const": "devin-desktop", "title": "Devin Desktop" },
                                    { "const": "github-copilot-app", "title": "GitHub Copilot App" },
                                    { "const": "opencode-desktop", "title": "OpenCode Desktop" }
                                ]
                            },
                            "uniqueItems": true,
                            "default": []
                        },
                        "control-planes": {
                            "type": "array",
                            "description": "List of Agent control planes to install",
                            "items": {
                                "type": "string",
                                "anyOf": [
                                    {
                                        "const": "openchamber",
                                        "title": "OpenChamber",
                                        "description": "Control plane for OpenCode"
                                    },
                                    {
                                        "const": "t3code-cli",
                                        "title": "T3 Code (CLI & Web)",
                                        "description": "Control plane for Claude Code, Codex, Cursor CLI, Grok Build, OpenCode and Antigravity"
                                    },
                                    {
                                        "const": "t3code-desktop",
                                        "title": "T3 Code Desktop",
                                        "description": "Control plane for Claude Code, Codex, Cursor CLI, Grok Build, OpenCode and Antigravity"
                                    },
                                    {
                                        "const": "zeron",
                                        "title": "Zeron",
                                        "description": "Control plane for Claude Code, Codex, Cursor CLI, Devin CLI, Grok Build, Hermes Agent, Pi, OpenCode and Antigravity"
                                    }
                                ]
                            },
                            "uniqueItems": true,
                            "default": []
                        }
                    }
                },
                "creative": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Setup NosArch for Creative work",
                            "default": false
                        }
                    }
                },
                "dev": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Setup NosArch for Software Development",
                            "default": false
                        },
                        "editors": {
                            "type": "array",
                            "description": "List of code editors to install",
                            "items": {
                                "type": "string",
                                "enum": ["code-oss", "codium", "jetbrains", "neovim", "vscode", "zed"]
                            },
                            "uniqueItems": true,
                            "default": []
                        },
                        "languages": {
                            "type": "array",
                            "description": "List of programming languages to setup",
                            "items": {
                                "type": "string",
                                "enum": [
                                    ".net",
                                    "go",
                                    "java-maven",
                                    "java-gradle",
                                    "javascript-bun",
                                    "javascript-deno",
                                    "javascript-node",
                                    "python",
                                    "rust",
                                    "zig"
                                ]
                            },
                            "uniqueItems": true,
                            "default": []
                        }
                    }
                },
                "gaming": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Setup NosArch for Gaming",
                            "default": false
                        }
                    }
                }
            }
        },
        "packaging": {
            "type": "object",
            "description": "Manage installed packages and packaging methods in NosArch",
            "properties": {
                "arch": {
                    "type": "object",
                    "properties": {
                        "install-packages": {
                            "type": "array",
                            "description": "Add other Arch packages not pre-installed by NosArch",
                            "items": {
                                "type": "string"
                            },
                            "uniqueItems": true,
                            "default": []
                        }
                    }
                },
                "aur": {
                    "type": "object",
                    "properties": {
                        "install-packages": {
                            "type": "array",
                            "description": "Add other packages from the AUR not pre-installed by NosArch",
                            "items": {
                                "type": "string"
                            },
                            "uniqueItems": true,
                            "default": []
                        }
                    }
                },
                "flatpak": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Add support for Flatpak packages to NosArch",
                            "default": false
                        },
                        "install-packages": {
                            "type": "array",
                            "description": "Add Flatpak packages to install system-wide",
                            "items": {
                                "type": "string"
                            },
                            "uniqueItems": true,
                            "default": []
                        },
                        "install-user-packages": {
                            "type": "array",
                            "description": "Add Flatpak packages to install for your user",
                            "items": {
                                "type": "string"
                            },
                            "uniqueItems": true,
                            "default": []
                        }
                    }
                },
                "homebrew": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Add support for Homebrew packages to NosArch",
                            "default": false
                        },
                        "install-casks": {
                            "type": "array",
                            "description": "Add Homebrew casks to install",
                            "items": {
                                "type": "string"
                            },
                            "uniqueItems": true,
                            "default": []
                        },
                        "install-formulae": {
                            "type": "array",
                            "description": "Add Homebrew formulae to install",
                            "items": {
                                "type": "string"
                            },
                            "uniqueItems": true,
                            "default": []
                        }
                    }
                },
                "snap": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Add support for Snap packages to NosArch",
                            "default": false
                        },
                        "install-snaps": {
                            "type": "object",
                            "description": "Add Snap packages to install, including the channel to install from",
                            "additionalProperties": {
                                "type": "string"
                            },
                            "propertyNames": {
                                "type": "string"
                            },
                            "default": {}
                        },
                        "install-classic-snaps": {
                            "type": "object",
                            "description": "Add Snap classic packages to install, including the channel to install from",
                            "additionalProperties": {
                                "type": "string"
                            },
                            "propertyNames": {
                                "type": "string"
                            },
                            "default": {}
                        }
                    }
                }
            }
        },
        "system": {
            "type": "object",
            "properties": {
                "enable_lts_kernel": {
                    "type": "boolean",
                    "description": "Setup Linux LTS kernel",
                    "default": false
                }
            }
        },
        "advanced": {
            "type": "object",
            "properties": {
                "enable_nosarch_works": {
                    "type": "boolean",
                    "description": "Setup this machine for working on the NosArch codebase",
                    "default": false
                }
            }
        }
    },
    "required": ["user"]
}
