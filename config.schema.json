{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/abdulk-id/NosArch/master/config.schema.json",
    "title": "NosArch Config",
    "description": "Configuration schema for NosArch",
    "type": "object",
    "properties": {
        "user": {
            "type": "object",
            "properties": {
                "username": {
                    "type": "string",
                    "description": "User name"
                },
                "fullname": {
                    "type": "string",
                    "description": "User's full name"
                },
                "git_email": {
                    "type": "string",
                    "description": "User's Git email",
                    "default": ""
                }
            },
            "required": ["username", "fullname"]
        },
        "profiles": {
            "type": "object",
            "properties": {
                "setup": {
                    "type": "boolean",
                    "description": "Enable to install the full setup"
                },
                "ai": {
                    "type": "boolean",
                    "description": "Enable to setup NosArch for AI and Agentic work"
                },
                "creative": {
                    "type": "boolean",
                    "description": "Enable to setup NosArch for creative work"
                },
                "dev": {
                    "type": "boolean",
                    "description": "Enable to setup NosArch for development work"
                },
                "gaming": {
                    "type": "boolean",
                    "description": "Enable to setup NosArch for gaming"
                }
            },
            "required": ["setup", "ai", "creative", "dev", "gaming"]
        },
        "enable_homebrew": {
            "type": "boolean",
            "description": "Enable to setup Homebrew",
            "default": false
        },
        "ai": {
            "type": "object",
            "properties": {
                "agents": {
                    "type": "array",
                    "description": "List of AI agents to install",
                    "items": {
                        "type": "string",
                        "anyOf": [
                            { "const": "antigravity-cli", "title": "Antigravity CLI" },
                            { "const": "claude-code", "title": "Claude Code" },
                            { "const": "codex", "title": "OpenAI Codex" },
                            { "const": "copilot-cli", "title": "GitHub Copilot CLI" },
                            { "const": "cursor-cli", "title": "Cursor CLI" },
                            { "const": "devin-cli", "title": "Devin CLI" },
                            { "const": "gemini-cli", "title": "Gemini CLI" },
                            { "const": "grok-build", "title": "Grok Build" },
                            { "const": "kilocode", "title": "Kilo Code" },
                            { "const": "omp", "title": "Oh My Pi" },
                            { "const": "opencode", "title": "OpenCode" },
                            { "const": "pi", "title": "Pi" }
                        ]
                    },
                    "uniqueItems": true
                },
                "apps": {
                    "type": "array",
                    "description": "List of AI apps to install",
                    "items": {
                        "type": "string",
                        "anyOf": [
                            { "const": "chatgpt-desktop", "title": "ChatGPT Desktop" },
                            { "const": "claude-desktop", "title": "Claude Desktop" },
                            { "const": "cursor-desktop", "title": "Cursor Desktop" },
                            { "const": "devin-desktop", "title": "Devin Desktop" },
                            { "const": "github-copilot-app", "title": "GitHub Copilot App" },
                            { "const": "opencode-desktop", "title": "OpenCode Desktop" }
                        ]
                    },
                    "uniqueItems": true
                },
                "control-planes": {
                    "type": "array",
                    "description": "List of Agent control planes to install",
                    "items": {
                        "type": "string",
                        "anyOf": [
                            {
                                "const": "openchamber",
                                "title": "OpenChamber",
                                "description": "Control plane for OpenCode"
                            },
                            {
                                "const": "t3code-cli",
                                "title": "T3 Code (CLI & Web)",
                                "description": "Control plane for Claude Code, Codex, Cursor CLI, Grok Build, OpenCode and Antigravity"
                            },
                            {
                                "const": "t3code-desktop",
                                "title": "T3 Code Desktop",
                                "description": "Control plane for Claude Code, Codex, Cursor CLI, Grok Build, OpenCode and Antigravity"
                            },
                            {
                                "const": "zeron",
                                "title": "Zeron",
                                "description": "Control plane for Claude Code, Codex, Cursor CLI, Devin CLI, Grok Build, Hermes Agent, Pi, OpenCode and Antigravity"
                            }
                        ]
                    },
                    "uniqueItems": true
                }
            }
        },
        "dev": {
            "type": "object",
            "properties": {
                "editors": {
                    "type": "array",
                    "description": "List of code editors to install",
                    "items": {
                        "type": "string",
                        "enum": ["code-oss", "codium", "cursor", "jetbrains", "neovim", "vscode", "zed"]
                    },
                    "uniqueItems": true
                },
                "languages": {
                    "type": "array",
                    "description": "List of programming languages to setup",
                    "items": {
                        "type": "string",
                        "enum": [
                            ".net",
                            "go",
                            "java-maven",
                            "java-gradle",
                            "javascript-bun",
                            "javascript-deno",
                            "javascript-node",
                            "python",
                            "rust",
                            "zig"
                        ]
                    },
                    "uniqueItems": true
                }
            }
        },
        "system": {
            "type": "object",
            "properties": {
                "enable_lts_kernel": {
                    "type": "boolean",
                    "description": "Enable to setup Linux LTS kernel",
                    "default": false
                }
            }
        },
        "setup": {
            "type": "object",
            "properties": {
                "enable_virtualization": {
                    "type": "boolean",
                    "description": "Enable to setup NosArch for running Virtual Machines",
                    "default": false
                }
            }
        },
        "user_packages": {
            "type": "object",
            "properties": {
                "arch": {
                    "type": "array",
                    "description": "Add any other Arch packages not installed by Decman",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "aur": {
                    "type": "array",
                    "description": "Add any other AUR packages not installed by Decman",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "flatpak": {
                    "type": "array",
                    "description": "Add any other Flatpak packages not installed by Decman",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "flatpak_user": {
                    "type": "array",
                    "description": "Add any other Flatpak (user-level) packages not installed by Decman",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "homebrew_casks": {
                    "type": "array",
                    "description": "Add any other Homebrew casks not installed by Decman",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "homebrew_formulae": {
                    "type": "array",
                    "description": "Add any other Homebrew formulae not installed by Decman",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                }
            }
        },
        "advanced": {
            "type": "object",
            "properties": {
                "enable_nosarch_works": {
                    "type": "boolean",
                    "description": "Enable to setup machine for working on the NosArch codebase",
                    "default": false
                }
            }
        }
    },
    "required": ["user", "profiles"]
}
