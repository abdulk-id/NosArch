#!/bin/bash

set -euo pipefail

# Usage:
#   launch-tui <command> [args...]

[[ $# -eq 0 ]] && {
    echo "Usage: $0 <command> [args...]"
    exit 1
}

# --- Dependencies ---
for cmd in hyprctl jq; do
    command -v "$cmd" &>/dev/null || {
        echo "Error: $cmd is required."
        exit 1
    }
done

: "${TERMINAL:=xdg-terminal-exec}"

# --- Command info ---
CMD=( "$@" )

FULL_CMD="${CMD[*]}"
CLASS="TUI.${FULL_CMD// /_}"

# --- Check for existing window ---
ADDR=$(
    hyprctl clients -j |
    jq -r \
        ".[] | select(.class == \"$CLASS\") | .address" |
    head -n 1
)

if [[ -n "$ADDR" && "$ADDR" != "null" ]]; then
    hyprctl dispatch focuswindow "address:$ADDR"
    exit 0
fi

# --- Build safely escaped command ---
printf -v CMD_STRING '%q ' "${CMD[@]}"

# --- Build inner shell script ---
read -r -d '' INNER_SCRIPT <<EOF || true
if ! $CMD_STRING; then
    echo
    echo "Process failed."
fi

echo
read -n 1 -s -r -p "Press any key to exit..."
echo
EOF

# --- Escape single quotes for shell ---
ESCAPED_SCRIPT=${INNER_SCRIPT//\'/\'\\\'\'}

# --- Final command ---
FINAL_CMD="$TERMINAL --class=$CLASS -e sh -lc '$ESCAPED_SCRIPT'"

# --- Launch through Lua ---
hyprctl eval "hl.exec_cmd([==[$FINAL_CMD]==], {
    float = true,
    size = {1280, 720},
    center = true
})"
