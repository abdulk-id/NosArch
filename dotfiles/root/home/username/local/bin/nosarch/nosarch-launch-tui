#!/bin/bash

set -euo pipefail

# Usage:
#   nosarch-launch-tui <command> [args...]

[[ $# -eq 0 ]] && {
    echo "Usage: $0 <command> [args...]"
    exit 1
}

# --- Dependencies ---
for cmd in hyprctl jq; do
    command -v "$cmd" &>/dev/null || {
        echo "Error: $cmd is required."
        exit 1
    }
done

: "${TERMINAL:=xdg-terminal-exec}"

# --- Command info ---
CMD=( "$@" )

FULL_CMD="${CMD[*]}"
TITLE="TUI.${FULL_CMD// /_}"

# --- Refocus existing window if present ---
ADDR=$(
    hyprctl clients -j |
    jq -r \
        ".[] | select(.title == \"$TITLE\") | .address" |
    head -n1
)

if [[ -n "$ADDR" && "$ADDR" != "null" ]]; then
    hyprctl eval "
    hl.dispatch(
        hl.dsp.focus({
            window = 'address:${ADDR}'
        })
    )
    "
    hyprctl eval "
    hl.dispatch(
        hl.dsp.window.alter_zorder({
            mode = 'top',
            window = 'address:${ADDR}'
        })
    )
    "
    exit 0
fi

# --- Build safely escaped command ---
printf -v CMD_STRING '%q ' "${CMD[@]}"

# --- Build inner shell script ---
read -r -d '' INNER_SCRIPT <<EOF || true
printf '\e]0;%s\a' '$TITLE'

if ! $CMD_STRING; then
    echo
    echo "Process failed."
fi

echo
read -n 1 -s -r -p "Press any key to exit..."
echo
EOF

ESCAPED_SCRIPT=${INNER_SCRIPT//\'/\'\\\'\'}

FINAL_CMD="$TERMINAL -e sh -lc '$ESCAPED_SCRIPT'"

hyprctl eval "hl.exec_cmd([==[$FINAL_CMD]==], {
    float = true,
    size = {1280, 720},
    center = true
})"
