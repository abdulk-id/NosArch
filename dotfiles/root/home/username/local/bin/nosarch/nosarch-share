#!/bin/bash

set -euo pipefail

_ensure_command() {
    if ! command -v "$1" &>/dev/null; then
        echo "Error: $1 is required but not found."
        exit 1
    fi
}

for cmd in localsend fzf xdg-terminal-exec; do
    _ensure_command "$cmd"
done


## === Actions logic ===
show_help() {
cat <<EOF
Usage: nosarch-share <command>

Commands:
    file            Share file(s)
    folder          Share folder(s)
    text            Share text
    clipboard       Share clipboard content
EOF
}


pick_files() {
    zenity --file-selection --multiple --separator=$'\n'
}
pick_folder() {
    zenity --file-selection --directory
}
input_text() {
    zenity --text-info \
        --editable \
        --title="Share Text" \
        --icon="document-edit-symbolic" \
        --width=100 \
        --height=50 \
        --font="JetbrainsMono Nerd Font" \
        --ok-label="Share" \
        --cancel-label="Cancel"
}

share_files() {
    local result
    result="$(pick_files)" || return 0

    local files=()
    mapfile -t files <<< "$result"
    [[ "${#files[@]}" -eq 0 ]] && return 0

    systemd-run --user --quiet --collect localsend --headless send "${files[@]}"
}

share_folder() {
    local folder
    folder="$(pick_folder)" || return 0

    systemd-run --user --quiet --collect localsend --headless send "$folder"
}

share_text() {
    local text
    text="$(input_text)" || return 0

    local tmpfile
    tmpfile="$(mktemp --suffix=.txt)"
    echo "$text" > "$tmpfile"

    systemd-run --user --quiet --collect localsend --headless send "$tmpfile"
}

share_clipboard() {
    local tmpfile
    tmpfile="$(mktemp --suffix=.txt)"
    wl-paste > "$tmpfile"

    systemd-run --user --quiet --collect localsend --headless send "$tmpfile"
}

## === Main logic ===
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        return
    fi

    case "${1:-}" in
        file|files)
            share_files
            ;;
        folder)
            share_folder
            ;;
        text)
            share_text
            ;;
        clipboard)
            share_clipboard
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
