#!/bin/bash

set -euo pipefail

_ensure_command() {
    if ! command -v "$1" &>/dev/null; then
        echo "Error: $1 is required but not found."
        exit 1
    fi
}


## === Actions logic ===
show_help() {
    cat <<EOF
Usage: nosarch-toggle <command> [option]

Commands:
    dnd             Toggle Notifications (Do Not Disturb)
    dnd-status      Get Do Not Disturb state
EOF
}


toggle_dnd() {
    dnd_status=$(get_dnd_status)

    if [[ $dnd_status == "true" ]]; then
        swaync-client --dnd-off;

        notify-send --urgency=low --transient \
            --app-name="NosArch" \
            "󰂚  Enabled Notifications";
    else
        notify-send --urgency=low --transient \
            --app-name="NosArch" \
            "󰂛  Silenced Notifications";

        sleep 1 # Ensures the notification registers before DND is enabled

        swaync-client --dnd-on;
    fi
}

get_dnd_status() {
    swaync-client --get-dnd
}

main() {
    if [[ $# -eq 0 ]]; then
        show_help
        return
    fi

    case "${1:-}" in
        dnd)
            toggle_dnd
            ;;
        dnd-status)
            get_dnd_status
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
