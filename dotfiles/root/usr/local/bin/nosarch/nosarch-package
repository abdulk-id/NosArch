#!/bin/sh

set -eu

. "/usr/local/bin/util/sudo-keepalive.sh"

show_help() {
    cat <<EOF
Usage:
    nosarch-package <command> [actions]

Commands:
    install <action>        Install packages
    update                  Update packages (Arch and AUR, and Flatpak if installed)
    remove                  Remove packages (Arch and AUR, and Flatpak if installed)
    remove-unused           Remove unused packages (Arch and AUR)
    help                    Show this help message

Install actions:
    arch                    Install packages from Arch repositories
    aur                     Install packages from AUR
    flatpak                 Install Flatpak packages
EOF
}

## === Utilities ===
_ensure_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Error: $1 is required but not found."
        exit 1
    fi
}

update_db() {
    if command -v updatedb >/dev/null 2>&1; then
        sudo updatedb
    fi
}

## === Features ===
install_arch_packages() {
    fzf_output=$(
        pacman -Slq | fzf \
        --multi \
        --preview 'pacman -Sii {1}' \
        --preview-label='alt-p: toggle description, alt-j/k: scroll description, tab: multi-select' \
        --preview-label-pos='bottom' \
        --preview-window 'down:55%:wrap' \
        --bind 'alt-p:toggle-preview' \
        --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
        --bind 'alt-k:preview-up,alt-j:preview-down' \
        --color 'pointer:green,marker:green'
    ) || return 0

    pkg_names=$(printf '%s\n' "$fzf_output" | tr '\n' ' ')

    if [ -n "$pkg_names" ]; then
        gum style --foreground 10 "▸ Authenticating..."
        echo

        if ! start_sudo_keepalive; then
            echo
            gum style --foreground 9 "x Authentication failed."
            return 1
        fi
        trap 'stop_sudo_keepalive' 0
        echo

        gum style --foreground 10 "▸ Installing packages..."
        echo

        if sudo pacman -S --needed --noconfirm $pkg_names; then
            update_db

            echo
            gum style --foreground 10 "✓ Installation complete!"
        else
            echo
            gum style --foreground 9 "x Installation failed."
        fi

        stop_sudo_keepalive
        trap - 0
    fi
}

install_aur_packages() {
    fzf_output=$(
        yay -Slqa | fzf \
            --multi \
            --preview 'yay -Siia {1}' \
            --preview-label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll description, tab: multi-select' \
            --preview-label-pos='bottom' \
            --preview-window 'down:55%:wrap' \
            --bind 'alt-p:toggle-preview' \
            --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
            --bind 'alt-k:preview-up,alt-j:preview-down' \
            --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5' \
            --bind 'alt-B:change-preview:yay -Siia {1}' \
            --color 'pointer:green,marker:green'
    ) || return 0

    pkg_names=$(printf '%s\n' "$fzf_output" | tr '\n' ' ')

    if [ -n "$pkg_names" ]; then
        gum style --foreground 10 "▸ Authenticating..."
        echo

        if ! start_sudo_keepalive; then
            echo
            gum style --foreground 9 "x Authentication failed."
            return 1
        fi
        trap 'stop_sudo_keepalive' 0
        echo

        gum style --foreground 10 "▸ Installing AUR packages..."
        echo

        if yay -S --noconfirm $pkg_names; then
            update_db

            echo
            gum style --foreground 10 "✓ Installation complete!"
        else
            echo
            gum style --foreground 9 "x Installation failed."
        fi

        stop_sudo_keepalive
        trap - 0
    fi

}

install_flatpak_packages() {
    TAB_CHAR=$(printf '\t')

    # APP_ID<TAB>NAME<TAB>DESCRIPTION
    pkg_selection=$(
        flatpak remote-ls --app --columns=application,name,description | \
        awk -F "$TAB_CHAR" '
            !seen[$1]++ {
                printf "%s\t%s  (%s)\t%s\n", $1, $2, $1, $3
            }
        ' | \
        sort -t "$TAB_CHAR" -k2,2f |
        fzf \
            --multi \
            --delimiter="$TAB_CHAR" \
            --with-nth=2 \
            --preview 'printf "%s\n" "{}" | cut -f3' \
            --preview-label 'alt-p: toggle description, alt-j/k: scroll description, tab: multi-select' \
            --preview-label-pos 'bottom' \
            --preview-window 'down:55%:wrap' \
            --bind 'alt-p:toggle-preview' \
            --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
            --bind 'alt-k:preview-up,alt-j:preview-down' \
            --color 'pointer:green,marker:green'
    ) || return 0

    if [ -n "$pkg_selection" ]; then
        pkg_ids=$(printf '%s\n' "$pkg_selection" | cut -f1 | tr '\n' ' ')

        gum style --foreground 10 "▸ Installing Flatpak packages..."
        echo

        if flatpak install --assumeyes $pkg_ids; then
            echo
            gum style --foreground 10 "✓ Installation complete!"
        else
            echo
            gum style --foreground 9 "x Installation failed."
        fi
    fi
}

update_packages() {
    gum style --foreground 10 "▸ Authenticating..."
    echo

    if ! start_sudo_keepalive; then
        echo
        gum style --foreground 9 "x Authentication failed."
        return 1
    fi
    trap 'stop_sudo_keepalive' 0
    echo

    gum style --foreground 10 "▸ Updating Arch and AUR packages..."
    echo

    if yay -Syu; then
        update_db

        echo
        gum style --foreground 10 "✓ Arch and AUR packages updated!"
    else
        echo
        gum style --foreground 9 "x Arch and AUR package update failed."
    fi

    if command -v flatpak >/dev/null 2>&1; then
        echo
        gum style --foreground 10 "▸ Updating Flatpak packages..."
        echo

        if flatpak update --assumeyes; then
            echo
            gum style --foreground 10 "✓ Flatpak packages updated!"
        else
            echo
            gum style --foreground 9 "x Flatpak package update failed."
        fi
    fi

    stop_sudo_keepalive
    trap - 0
}

remove_packages() {
    TAB_CHAR=$(printf '\t')

    entries=$(
        {
            yay -Qeqn | awk '{print "[arch]   \t" $0}'
            yay -Qeqm | awk '{print "[aur]    \t" $0}'

            if command -v flatpak >/dev/null 2>&1; then
                flatpak list --app --columns=application | awk '{print "[flatpak]\t" $0}'
            fi
        } | sort -t"$TAB_CHAR" -k2 -f
    )

    selected=$(
        printf '%s\n' "$entries" |
        fzf \
            --multi \
            --delimiter "$TAB_CHAR" \
            --with-nth 1,2 \
            --preview '
                case {1} in
                    "[arch]"|"[aur]")
                        yay -Qi -- {2}
                        ;;
                    "[flatpak]")
                        flatpak info {2}
                        ;;
                esac
            ' \
            --preview-label 'alt-p: toggle description, alt-j/k: scroll description, tab: multi-select' \
            --preview-label-pos 'bottom' \
            --preview-window 'down:55%:wrap' \
            --bind 'alt-p:toggle-preview' \
            --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
            --bind 'alt-k:preview-up,alt-j:preview-down' \
            --color 'pointer:red,marker:red'
    ) || return 0

    [ -z "$selected" ] && return 0

    pacman_pkgs=$(printf '%s\n' "$selected" | awk -F '\t' '$1 != "[flatpak]" { print $2 }' | tr '\n' ' ')
    flatpak_pkgs=$(printf '%s\n' "$selected" | awk -F '\t' '$1 == "[flatpak]" { print $2 }' | tr '\n' ' ')

    gum style --foreground 10 "▸ Authenticating..."
    echo

    if ! start_sudo_keepalive; then
        echo
        gum style --foreground 9 "x Authentication failed."
        return 1
    fi
    trap 'stop_sudo_keepalive' 0
    echo

    success=true

    if [ -n "$pacman_pkgs" ]; then
        gum style --foreground 10 "▸ Removing Arch/AUR packages..."
        echo

        if yay -Rns --noconfirm $pacman_pkgs; then
            echo
            gum style --foreground 10 "✓ Arch/AUR packages removed!"
        else
            echo
            gum style --foreground 9 "x Arch/AUR removal failed."
            success=false
        fi
        echo
    fi

    if [ -n "$flatpak_pkgs" ]; then
        gum style --foreground 10 "▸ Removing Flatpak packages..."
        echo

        if flatpak uninstall --assumeyes $flatpak_pkgs; then
            echo
            gum style --foreground 10 "✓ Flatpak packages removed!"
        else
            echo
            gum style --foreground 9 "x Flatpak removal failed."
            success=false
        fi
    fi

    stop_sudo_keepalive
    trap - 0

    $success
}

remove_unused_packages() {
    gum style --foreground 10 "▸ Removing unused (orphan) packages..."
    echo

    if pacman -Qdtq | sudo pacman -Rns --noconfirm -; then
        echo
        gum style --foreground 10 "✓ Unused packages removed!"
    else
        echo
        gum style --foreground 9 "x Removal failed."
    fi
}


## ===
main() {
    if [ "$#" -eq 0 ]; then
        show_help
        return
    fi

    case "${1:-}" in
        install)
            case "${2:-}" in
                arch)
                    install_arch_packages
                    ;;
                aur)
                    install_aur_packages
                    ;;
                flatpak)
                    install_flatpak_packages
                    ;;
                *)
                    echo "Unknown install action: $2"
                    show_help
                    exit 1
                    ;;
            esac
            ;;
        update)
            update_packages
            ;;
        remove)
            remove_packages
            ;;
        remove-unused)
            remove_unused_packages
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

for cmd in gum fzf yay; do
    _ensure_command "$cmd"
done

main "$@"
