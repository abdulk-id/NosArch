# Copied from Omarchy
# https://github.com/basecamp/omarchy/blob/9cf1852525a5f7de26d3162db9d61e2f5c1d5523/default/wireplumber/wireplumber.conf.d/alsa-soft-mixer.conf

## Use software volume control for all ALSA devices.
## This prevents hardware mixer quirks (like muffled audio on Realtek codecs)
## and provides consistent volume behavior across all hardware.

monitor.alsa.rules = [
    {
        matches = [
            {
                device.name = "~alsa_card.*"
            }
        ]
        actions = {
            update-props = {
                api.alsa.soft-mixer = true
            }
        }
    }
]

# Disabled because it messed with audio levels (all audio was extremely low)
