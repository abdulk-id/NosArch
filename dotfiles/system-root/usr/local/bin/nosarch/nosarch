#!/bin/sh
# Managed by NosArch

set -eu

TAB=$(printf '\t')
NL='
'
CR=$(printf '\r')

case "$0" in
    */*) script_path=$0 ;;
    *)
        script_path=$(command -v "$0") || {
            echo "Error: cannot locate the nosarch script directory." >&2
            exit 1
        }
        ;;
esac

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$script_path")" && pwd)

# One record per script: group TAB name TAB binary TAB summary TAB hidden
RECORDS=""
# One entry per route: route TAB binary
ROUTES=""
# Unique groups of visible scripts, newline-separated
VISIBLE_GROUPS=""

register_command() {
    file=$1
    binary=${file##*/}
    stem=${binary#nosarch-}

    case "$stem" in
        *-*)
            group=${stem%%-*}
            name=${stem#*-}
            name=$(printf '%s' "$name" | tr '-' ' ')
            ;;
        *)
            group=$stem
            name=""
            ;;
    esac

    summary=""
    hidden=false

    line_count=0
    while IFS= read -r line; do
        line_count=$((line_count + 1))
        if [ "$line_count" -gt 40 ]; then
            break
        fi

        case "$line" in
            "")
                continue
                ;;
            "#"*)
                comment=${line#\#}
                while [ "${comment# }" != "$comment" ]; do
                    comment=${comment# }
                done

                case "$comment" in
                    nosarch:*)
                        kv=${comment#nosarch:}
                        key=${kv%%=*}
                        value=${kv#*=}
                        value=${value%"$CR"}

                        case "$key" in
                            summary) summary=$value ;;
                            group) group=$value ;;
                            name) name=$value ;;
                            hidden)
                                if [ "$value" = "true" ]; then
                                    hidden=true
                                fi
                                ;;
                        esac
                        ;;
                esac
                ;;
            *)
                break
                ;;
        esac
    done < "$file"

    if [ -n "$name" ]; then
        route="nosarch $group $name"
    else
        route="nosarch $group"
    fi

    RECORDS="${RECORDS:+${RECORDS}${NL}}${group}${TAB}${name}${TAB}${binary}${TAB}${summary}${TAB}${hidden}"
    ROUTES="${ROUTES:+${ROUTES}${NL}}${route}${TAB}${binary}"

    if [ "$hidden" != "true" ]; then
        case "${NL}${VISIBLE_GROUPS}${NL}" in
            *"${NL}${group}${NL}"*) ;;
            *) VISIBLE_GROUPS="${VISIBLE_GROUPS:+${VISIBLE_GROUPS}${NL}}${group}" ;;
        esac
    fi
}

load_commands() {
    for file in "$SCRIPT_DIR"/nosarch-*; do
        if [ -f "$file" ] && [ -x "$file" ]; then
            register_command "$file"
        fi
    done
}

lookup_route() {
    printf '%s\n' "$ROUTES" | awk -F'\t' -v r="$1" '$1 == r { print $2; exit }'
}

group_visible() {
    printf '%s\n' "$RECORDS" | awk -F'\t' -v g="$1" '
        $1 == g && $5 != "true" { found = 1; exit }
        END { exit !found }'
}

suggest_route() {
    first=$1
    suggestion=$(printf '%s\n' "$VISIBLE_GROUPS" | awk -v p="$first" 'index($0, p) == 1 { print; exit }')

    if [ -z "$suggestion" ]; then
        suggestion=$(printf '%s\n' "$RECORDS" | awk -F'\t' -v p="$first" '
            {
                r = $1
                if ($2 != "") r = r " " $2
                if (index(r, p) == 1) {
                    split(r, w, " ")
                    print w[1]
                    exit
                }
            }')
    fi

    printf '%s' "$suggestion"
}

collect_rows() {
    include_all=$1
    filter_group=${2:-}

    old_ifs=$IFS
    IFS=$NL
    set -f

    for rec in $RECORDS; do
        if [ -z "$rec" ]; then
            continue
        fi

        rec_group=${rec%%"$TAB"*}
        rest=${rec#*"$TAB"}
        rec_name=${rest%%"$TAB"*}
        rest=${rest#*"$TAB"}
        rest=${rest#*"$TAB"}
        rec_summary=${rest%%"$TAB"*}
        rec_hidden=${rest#*"$TAB"}

        if [ -n "$filter_group" ] && [ "$rec_group" != "$filter_group" ]; then
            continue
        fi

        if [ "$include_all" != "true" ] && [ "$rec_hidden" = "true" ]; then
            continue
        fi

        if [ "$include_all" = "true" ] && [ "$rec_hidden" = "true" ]; then
            rec_summary="${rec_summary:+${rec_summary} }(hidden)"
        fi

        if [ -n "$rec_name" ]; then
            printf '%s\t%s\n' "nosarch $rec_group $rec_name" "$rec_summary"
        else
            printf '%s\t%s\n' "nosarch $rec_group" "$rec_summary"
        fi
    done

    IFS=$old_ifs
    set +f
}

print_command_table() {
    awk -F'\t' '
        {
            route[NR] = $1
            sum[NR] = $2
            if (length($1) > max) max = length($1)
        }
        END {
            for (i = 1; i <= NR; i++) {
                line = sprintf("    %-*s    %s", max, route[i], sum[i])
                sub(/[ \t]+$/, "", line)
                print line
            }
        }'
}

show_main_help() {
    cat <<'EOF'
NosArch command center

Usage:
    nosarch <command> [args...]
    nosarch commands [--all]
    nosarch <command> --help

Commands:
EOF
    collect_rows false "" | sort | print_command_table
    echo
    echo "Run 'nosarch commands --all' to include hidden commands."
}

show_commands_help() {
    cat <<'EOF'
Usage:
    nosarch commands [--all]

List commands known to the NosArch CLI.

Options:
    --all    Include commands explicitly marked hidden
EOF
}

show_commands() {
    if [ "$1" = "true" ]; then
        echo "NosArch commands (all):"
    else
        echo "NosArch commands:"
    fi

    collect_rows "$1" "" | sort | print_command_table
}

show_group_help() {
    echo "$1 commands:"
    collect_rows false "$1" | sort | print_command_table
}

parse_commands_args() {
    include_all=false

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --all)
                include_all=true
                ;;
            help|--help|-h)
                show_commands_help
                return 0
                ;;
            *)
                echo "Unknown option for nosarch commands: $1" >&2
                show_commands_help >&2
                exit 1
                ;;
        esac
        shift
    done

    show_commands "$include_all"
}

dispatch() {
    argc=$#

    n=$argc
    while [ "$n" -ge 1 ]; do
        route=""
        hyphen=""
        i=0
        for arg in "$@"; do
            i=$((i + 1))
            if [ "$i" -gt "$n" ]; then
                break
            fi
            route="${route}${route:+ }${arg}"
            hyphen="${hyphen}${hyphen:+-}${arg}"
        done

        binary=$(lookup_route "nosarch $route")

        if [ -z "$binary" ]; then
            candidate="${SCRIPT_DIR}/nosarch-${hyphen}"
            if [ -f "$candidate" ] && [ -x "$candidate" ]; then
                binary="nosarch-${hyphen}"
            fi
        fi

        if [ -n "$binary" ]; then
            target="${SCRIPT_DIR}/${binary}"
            k=$n
            while [ "$k" -gt 0 ]; do
                shift
                k=$((k - 1))
            done
            exec "${target}" "$@"
        fi

        n=$((n - 1))
    done

    if group_visible "$1"; then
        if [ "$argc" -eq 1 ]; then
            show_group_help "$1"
            return 0
        fi

        case "$2" in
            -h|--help)
                show_group_help "$1"
                return 0
                ;;
        esac
    fi

    echo "Unknown nosarch command: nosarch $*" >&2
    suggestion=$(suggest_route "$1")
    if [ -n "$suggestion" ]; then
        echo "Did you mean: nosarch ${suggestion} ?" >&2
    fi
    echo
    echo "Run 'nosarch commands' to discover available commands." >&2
    exit 1
}

main() {
    load_commands

    if [ "$#" -eq 0 ]; then
        show_main_help
        return 0
    fi

    case "$1" in
        help|--help|-h)
            show_main_help
            ;;
        commands)
            shift
            parse_commands_args "$@"
            ;;
        *)
            dispatch "$@"
            ;;
    esac
}

main "$@"
