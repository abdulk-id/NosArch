#!/bin/sh
# Managed by NosArch

set -eu

show_help() {
    cat <<EOF
Usage: nosarch-battery <command>

Commands:
    power-profile-auto      Set the power profile from the current power state
    help                    Show this help message
EOF
}

## === Utilities ===

# Battery percentage at or below which the system drops to power-saver and warns
# the user once per discharge cycle.
LOW_BATTERY_PERCENTAGE=20

# Records that the low-battery warning has already been shown, so it fires once
# per discharge cycle rather than on every timer tick.
#
# This lives in the user runtime directory. When invoked from udev the script
# runs as root with no session, so warning state is skipped there and the
# two-minute timer picks it up instead.
LOW_BATTERY_FLAG="${XDG_RUNTIME_DIR:-}/nosarch-battery-warned"

# Sends a desktop notification, and never fails the caller.
#
# udev `RUN+=` executes as root with no session bus, so a bare `notify-send`
# exits non-zero there. Under `set -eu` that would abort the caller before it
# sets the power profile, so notifications are routed to the active graphical
# session when running as root, and are best-effort either way.
_notify() {
    if [ "$(id -u)" -eq 0 ]; then
        session_uid=$(loginctl list-sessions --no-legend 2>/dev/null | while read -r session_id uid _; do
            state=$(loginctl show-session "$session_id" --property=State --value 2>/dev/null)
            type=$(loginctl show-session "$session_id" --property=Type --value 2>/dev/null)

            if [ "$state" = "active" ] && { [ "$type" = "wayland" ] || [ "$type" = "x11" ]; }; then
                echo "$uid"
                break
            fi
        done)

        [ -n "${session_uid:-}" ] || return 0

        runuser --user "#$session_uid" -- \
            env "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$session_uid/bus" \
            notify-send "$@" >/dev/null 2>&1 || true
    else
        notify-send "$@" >/dev/null 2>&1 || true
    fi

    return 0
}

# Echoes "on-ac" or "on-battery".
#
# Only "Mains" devices are consulted. "USB" is deliberately ignored: on some
# laptops (Dell XPS 13) a USB-C port reports online=1 permanently, which would
# pin the machine to the AC profile on battery.
_power_source() {
    for power_supply in /sys/class/power_supply/*; do
        [ -r "$power_supply/type" ] && [ -r "$power_supply/online" ] || continue
        [ "$(cat "$power_supply/type")" = "Mains" ] || continue

        if [ "$(cat "$power_supply/online")" = "1" ]; then
            echo "on-ac"
            return 0
        fi
    done

    echo "on-battery"
}

# Echoes the first battery's charge percentage, or nothing if there is no battery.
_battery_percentage() {
    for power_supply in /sys/class/power_supply/*; do
        [ -r "$power_supply/type" ] && [ -r "$power_supply/capacity" ] || continue
        [ "$(cat "$power_supply/type")" = "Battery" ] || continue

        cat "$power_supply/capacity"
        return 0
    done
}

# Echoes "performance" when power-profiles-daemon offers it, "balanced" otherwise.
# Not every platform exposes a performance profile.
_ac_profile() {
    if powerprofilesctl list 2>/dev/null | grep --quiet '^\s*[* ]\s*performance:'; then
        echo "performance"
    else
        echo "balanced"
    fi
}

# Applies a profile, skipping the call when it is already active so plug/unplug
# events do not spam power-profiles-daemon.
_set_power_profile() {
    target_profile="$1"

    if [ "$(powerprofilesctl get 2>/dev/null)" = "$target_profile" ]; then
        return 0
    fi

    powerprofilesctl set "$target_profile"
}

_clear_low_battery_warning() {
    [ -n "${XDG_RUNTIME_DIR:-}" ] || return 0

    rm --force "$LOW_BATTERY_FLAG"
}

_warn_low_battery_once() {
    percentage="$1"

    [ -n "${XDG_RUNTIME_DIR:-}" ] || return 0
    [ -e "$LOW_BATTERY_FLAG" ] && return 0

    _notify --urgency=critical --transient \
        --icon=battery-level-10-symbolic \
        "Low Battery (${percentage}%)" \
        "Plug in soon to recharge"

    touch "$LOW_BATTERY_FLAG"
}

## === Features ===

# Selects the power profile from the current power state:
#
#   on AC                              -> performance
#   on battery, above the low mark     -> balanced
#   on battery, at or below the mark   -> power-saver, and warn once
#
# Run both by the udev rule (on plug/unplug) and by the battery monitor timer
# (so percentage changes are picked up without a power event).
auto_set_power_profile() {
    # udev fires the rule before sysfs `online` is updated on some laptops.
    # A short settle delay lets the kernel catch up before it is read.
    sleep 0.3

    if [ "$(_power_source)" = "on-ac" ]; then
        _clear_low_battery_warning
        _set_power_profile "$(_ac_profile)"
        return 0
    fi

    percentage=$(_battery_percentage)

    if [ -n "$percentage" ] && [ "$percentage" -le "$LOW_BATTERY_PERCENTAGE" ]; then
        _set_power_profile "power-saver"
        _warn_low_battery_once "$percentage"
    else
        _clear_low_battery_warning
        _set_power_profile "balanced"
    fi
}

## ===
main() {
    if [ "$#" -eq 0 ]; then
        show_help
        return
    fi

    case "${1:-}" in
        power-profile-auto)
            auto_set_power_profile
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
