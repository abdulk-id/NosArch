#!/bin/sh
# Managed by NosArch
# nosarch:summary=Install, update, and remove packages and AppImages

set -eu

PACKAGE_LIB_DIR="/usr/local/bin/util/package"

. "/usr/local/bin/util/sudo-keepalive.sh"
. "$PACKAGE_LIB_DIR/common.sh"

# Shipped by SystemModule rather than by a packaging module, because it has to stay
# available after a method's module is disabled. See the file itself.
. "$PACKAGE_LIB_DIR/cleanup.sh"

# Every packaging method nosarch-package can drive, in the order the remove picker lists and removes them.
# Arch and AUR are defined below, so they have no library file and are skipped here. The rest ship with the module
# that enables them, and are absent once that module is disabled, which is how the CLI follows the switch.
PACKAGE_METHODS="arch aur appimage flatpak homebrew snap"

for method in $PACKAGE_METHODS; do
    if [ -f "$PACKAGE_LIB_DIR/$method.sh" ]; then
        . "$PACKAGE_LIB_DIR/$method.sh"
    fi
done

show_help() {
    cat <<EOF
Usage:
    nosarch-package install <method> [options]
    nosarch-package update
    nosarch-package remove
    nosarch-package remove-unused
    nosarch-package cleanup
    nosarch-package <method> <command>
    nosarch-package help
EOF

    printf '\nInstall methods:\n'

    for method in $PACKAGE_METHODS; do
        if command -v "${method}_install" >/dev/null 2>&1; then
            printf '    %-24s %s\n' "$method" "$("${method}_summary")"
        fi
    done

    cat <<'EOF'

Method commands:
    appimage list          List installed AppImages

AppImage options:
    --confirm               Ask before installing each file, then install it

AppImages are not updated automatically. To update one, install the new file and remove the old one.
EOF
}

## === Arch and AUR ===
arch_summary() {
    printf '%s\n' "Install packages from Arch repositories"
}

aur_summary() {
    printf '%s\n' "Install packages from the AUR"
}

# Registered twice rather than as one `[arch]|[aur]` arm: an arm is a literal case
# pattern, so the two tags have to be spelled out separately.
register_preview '[arch]' 'paru -Qi -- {3}'
register_preview '[aur]' 'paru -Qi -- {3}'

arch_install() {
    for cmd in gum fzf; do
        _ensure_command "$cmd"
    done

    candidates=$(pacman -Slq)

    fzf_output=$(
        fzf_select "$candidates" 'pacman -Sii {1}' --color 'pointer:green,marker:green'
    ) || return 0

    pkg_names=$(printf '%s\n' "$fzf_output" | tr '\n' ' ')

    if [ -n "$pkg_names" ]; then
        # shellcheck disable=SC2086
        # pacman does not call sudo itself. with_sudo only keeps the credential alive.
        if with_sudo sudo pacman -S --needed --noconfirm $pkg_names; then
            update_db

            gum style --foreground 10 "✓ Installation complete!"
        else
            gum style --foreground 9 "x Installation failed."
            return 1
        fi
    fi
}

aur_install() {
    for cmd in gum fzf paru; do
        _ensure_command "$cmd"
    done

    candidates=$(paru -Slqa)

    fzf_output=$(
        fzf_select "$candidates" 'paru -Siia {1}' --color 'pointer:green,marker:green'
    ) || return 0

    pkg_names=$(printf '%s\n' "$fzf_output" | tr '\n' ' ')

    if [ -n "$pkg_names" ]; then
        # shellcheck disable=SC2086
        if with_sudo paru -S --noconfirm $pkg_names; then
            update_db

            gum style --foreground 10 "✓ Installation complete!"
        else
            gum style --foreground 9 "x Installation failed."
            return 1
        fi
    fi
}

# `paru -Syu` upgrades the repositories and the AUR in one transaction, so there is no separate AUR step. It asks for
# the password itself rather than going through with_sudo, since paru invokes sudo for the sync and again for the build.
arch_update() {
    _ensure_command gum
    _ensure_command paru

    gum style --foreground 10 "▸ Authenticating..."

    if ! start_sudo_keepalive; then
        report_error "Authentication failed."
        return 1
    fi

    trap 'stop_sudo_keepalive' 0
    echo

    status=0

    gum style --foreground 10 "▸ Updating Arch and AUR packages..."

    if paru -Syu --noconfirm; then
        # paru -Syu = paru --sync --refresh --sysupgrade
        update_db

        gum style --foreground 10 "✓ Arch and AUR packages updated!"
    else
        gum style --foreground 9 "x Arch and AUR package update failed."
        status=1
    fi

    stop_sudo_keepalive
    trap - 0

    return "$status"
}

arch_entries() {
    command -v paru >/dev/null 2>&1 || return 0

    paru -Qeqn | awk '{print "[arch]\tarch\t" $0}'
}

# Removes the selected rows, whose package names are in column 3.
arch_remove() {
    pacman_pkgs=$(printf '%s\n' "$1" | cut -f 3 | tr '\n' ' ')

    gum style --foreground 10 "▸ Removing Arch packages..."

    # shellcheck disable=SC2086
    if with_sudo sudo pacman -Rns --noconfirm $pacman_pkgs; then
        gum style --foreground 10 "✓ Arch packages removed!"
    else
        gum style --foreground 9 "x Arch removal failed."
        return 1
    fi
}

arch_remove_unused() {
    gum style --foreground 10 "▸ Removing unused Arch/AUR packages..."

    orphans=$(pacman -Qdtq || true)

    if [ -z "$orphans" ]; then
        gum style --foreground 10 "✓ No unused Arch/AUR packages found!"
    elif printf '%s\n' "$orphans" | with_sudo sudo pacman -Rns --noconfirm -; then
        gum style --foreground 10 "✓ Unused Arch/AUR packages removed!"
    else
        gum style --foreground 9 "x Removing unused Arch/AUR packages failed."
        return 1
    fi
}

aur_entries() {
    command -v paru >/dev/null 2>&1 || return 0

    paru -Qeqm | awk '{print "[aur]\taur\t" $0}'
}

# Removes the selected rows. `paru -Rns` handles an AUR package's build files and
# dependencies, which `pacman -Rns` alone would leave behind.
aur_remove() {
    aur_pkgs=$(printf '%s\n' "$1" | cut -f 3 | tr '\n' ' ')

    gum style --foreground 10 "▸ Removing AUR packages..."

    # shellcheck disable=SC2086
    if with_sudo paru -Rns --noconfirm $aur_pkgs; then
        gum style --foreground 10 "✓ AUR packages removed!"
    else
        gum style --foreground 9 "x AUR removal failed."
        return 1
    fi
}

# pacman -Qdtq already reports AUR packages that nothing depends on, since it reads the same installed set, so AUR has
# no orphan step of its own.

## === Aggregate commands ===

# update and remove-unused have nothing to merge across methods, so each method runs its own.
# remove is not here: it builds one picker across every method.
run_for_each_method() {
    verb=$1
    status=0

    for method in $PACKAGE_METHODS; do
        if command -v "${method}_${verb}" >/dev/null 2>&1; then
            if ! "${method}_${verb}"; then
                status=1
            fi

            echo
        fi
    done

    return "$status"
}

remove_packages() {
    _ensure_command gum
    _ensure_command fzf

    entries=$(
        for method in $PACKAGE_METHODS; do
            if command -v "${method}_entries" >/dev/null 2>&1; then
                "${method}_entries"
            fi
        done | sort -t"$TAB_CHAR" -k3,3 -f
    )

    if [ -z "$entries" ]; then
        gum style --foreground 10 "No packages to remove."
        return 0
    fi

    # === Entry columns, for reference ===
    #
    # Every row of `entries` above is tab-separated, and each packaging method fills in
    # the columns it needs. {n} below is how fzf addresses them, so the numbering is the
    # one that matters when reading the --preview block:
    #
    #   1  display type   "[arch]", "[aur]", "[flatpak]", "[appimage]", "[homebrew]", "[snap]"
    #                     Tag shown in the fzf list, and what the preview switches on.
    #   2  internal type  "arch", "aur", "flatpak", "appimage", "formula", "cask", "snap"
    #                     Hidden from the list (--with-nth 1,3). Only Homebrew needs it,
    #                     to tell a cask from a formula; for everything else it repeats
    #                     column 1 without the brackets.
    #   3  name           The package name, or the display name for AppImages. This is
    #                     what the user sees, what the list is sorted by (-k3,3), and
    #                     what gets passed to the package manager. Used by every method.
    #   4  (AppImages)    Registry id, used to delete the ~/.local/bin symlink. Only
    #                     AppImage rows carry it.
    #   5  (AppImages)    Path to the generated .desktop file, so the preview can show
    #                     the entry rather than rebuild its path. Only AppImage rows
    #                     carry it.
    #
    # Columns 4 and 5 are unset for the other methods, which need only the name.
    #
    # Each method's rows are then handed back to that method's remove, which reads the
    # columns it needs and ignores the rest.
    #
    # The preview cases come from the method libraries rather than being spelled out
    # here. fzf runs --preview in a shell of its own, where nothing this script defined
    # exists, so each library appends its own arm with `register_preview` while being
    # sourced.
    selected=$(
        fzf_select "$entries" "
            case {1} in
${PREVIEW_CASES}
                *)
                    exit 0
                    ;;
            esac
        " \
            --delimiter "$TAB_CHAR" \
            --with-nth 1,3 \
            --color 'pointer:red,marker:red'
    ) || return 0

    [ -n "$selected" ] || return 0

    status=0

    for method in $PACKAGE_METHODS; do
        if ! command -v "${method}_remove" >/dev/null 2>&1; then
            continue
        fi

        rows=$(
            printf '%s\n' "$selected" |
                awk -F "$TAB_CHAR" -v tag="[$method]" '$1 == tag'
        )

        if [ -z "$rows" ]; then
            continue
        fi

        if ! "${method}_remove" "$rows"; then
            status=1
        fi

        echo
    done

    return "$status"
}

# The install methods this machine can actually use right now, one per line. The install
# menu builds itself from this, so a method whose module is disabled or whose runtime is
# absent never appears there. A method that defines no `available` is always usable.
list_methods() {
    for method in $PACKAGE_METHODS; do
        if ! command -v "${method}_install" >/dev/null 2>&1; then
            continue
        fi

        if command -v "${method}_available" >/dev/null 2>&1; then
            if ! "${method}_available"; then
                continue
            fi
        fi

        printf '%s\n' "$method"
    done
}

main() {
    if [ "$#" -eq 0 ]; then
        show_help
        return 0
    fi

    case "$1" in
        update)
            run_for_each_method update
            ;;
        remove)
            remove_packages
            ;;
        remove-unused)
            run_for_each_method remove_unused
            ;;
        cleanup)
            cleanup
            ;;
        list-methods)
            list_methods
            ;;
        install)
            shift
            method=${1:-}

            if [ -z "$method" ]; then
                echo "Usage: nosarch-package install <method> [options]" >&2
                show_help >&2
                exit 1
            fi

            shift

            if ! command -v "${method}_install" >/dev/null 2>&1; then
                echo "Unknown install method: $method" >&2
                show_help >&2
                exit 1
            fi

            "${method}_install" "$@"
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            method=$1
            verb=${2:-}

            if [ -z "$verb" ] || ! command -v "${method}_${verb}" >/dev/null 2>&1; then
                echo "Unknown command: nosarch-package $*" >&2
                show_help >&2
                exit 1
            fi

            shift 2
            "${method}_${verb}" "$@"
            ;;
    esac
}

main "$@"
