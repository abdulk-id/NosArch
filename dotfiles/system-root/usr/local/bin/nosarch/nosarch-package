#!/bin/sh
# Managed by NosArch
# nosarch:summary=Install, update, and remove packages

set -eu

. "/usr/local/bin/util/sudo-keepalive.sh"

show_help() {
    cat <<EOF
Usage:
    nosarch-package <command> [actions]

Commands:
    install <action>        Install packages
    update                  Update packages (Arch and AUR, and Flatpak and Homebrew if installed)
    remove                  Remove packages (Arch and AUR, and Flatpak and Homebrew if installed)
    remove-unused           Remove unused packages (Arch and AUR, and Flatpak and Homebrew if installed)
    help                    Show this help message

Install actions:
    arch                    Install packages from Arch repositories
    aur                     Install packages from AUR
    flatpak                 Install Flatpak packages
EOF
}

## === Utilities ===
_ensure_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Error: $1 is required but not found."
        exit 1
    fi
}

update_db() {
    if command -v updatedb >/dev/null 2>&1; then
        sudo updatedb
    fi
}

## === Features ===
install_arch_packages() {
    for cmd in gum fzf; do
        _ensure_command "$cmd"
    done

    fzf_output=$(
        pacman -Slq | fzf \
        --multi \
        --preview 'pacman -Sii {1}' \
        --preview-label='alt-p: toggle description, alt-j/k: scroll description, tab: multi-select' \
        --preview-label-pos='bottom' \
        --preview-window 'down:55%:wrap' \
        --bind 'alt-p:toggle-preview' \
        --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
        --bind 'alt-k:preview-up,alt-j:preview-down' \
        --color 'pointer:green,marker:green'
    ) || return 0

    pkg_names=$(printf '%s\n' "$fzf_output" | tr '\n' ' ')

    if [ -n "$pkg_names" ]; then
        gum style --foreground 10 "▸ Authenticating..."

        if ! start_sudo_keepalive; then
            gum style --foreground 9 "x Authentication failed."
            return 1
        fi
        trap 'stop_sudo_keepalive' 0
        echo

        gum style --foreground 10 "▸ Installing packages..."

        if sudo pacman -S --needed --noconfirm $pkg_names; then
            update_db

            gum style --foreground 10 "✓ Installation complete!"
        else
            gum style --foreground 9 "x Installation failed."
        fi

        stop_sudo_keepalive
        trap - 0
    fi
}

install_aur_packages() {
    for cmd in gum fzf yay; do
        _ensure_command "$cmd"
    done

    fzf_output=$(
        yay -Slqa | fzf \
            --multi \
            --preview 'yay -Siia {1}' \
            --preview-label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll description, tab: multi-select' \
            --preview-label-pos='bottom' \
            --preview-window 'down:55%:wrap' \
            --bind 'alt-p:toggle-preview' \
            --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
            --bind 'alt-k:preview-up,alt-j:preview-down' \
            --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5' \
            --bind 'alt-B:change-preview:yay -Siia {1}' \
            --color 'pointer:green,marker:green'
    ) || return 0

    pkg_names=$(printf '%s\n' "$fzf_output" | tr '\n' ' ')

    if [ -n "$pkg_names" ]; then
        gum style --foreground 10 "▸ Authenticating..."

        if ! start_sudo_keepalive; then
            gum style --foreground 9 "x Authentication failed."
            return 1
        fi
        trap 'stop_sudo_keepalive' 0
        echo

        gum style --foreground 10 "▸ Installing AUR packages..."

        if yay -S --noconfirm $pkg_names; then
            update_db

            gum style --foreground 10 "✓ Installation complete!"
        else
            echo
            gum style --foreground 9 "x Installation failed."
        fi

        stop_sudo_keepalive
        trap - 0
    fi

}

install_flatpak_packages() {
    if command -v flatpak >/dev/null 2>&1; then
        for cmd in gum fzf; do
            _ensure_command "$cmd"
        done

        TAB_CHAR=$(printf '\t')

        # APP_ID<TAB>NAME<TAB>DESCRIPTION
        pkg_selection=$(
            flatpak remote-ls --app --columns=application,name,description | \
            awk -F "$TAB_CHAR" '
                !seen[$1]++ {
                    printf "%s\t%s  (%s)\t%s\n", $1, $2, $1, $3
                }
            ' | \
            sort -t "$TAB_CHAR" -k2,2f |
            fzf \
                --multi \
                --delimiter="$TAB_CHAR" \
                --with-nth=2 \
                --preview 'printf "%s\n" "{}" | cut -f3' \
                --preview-label 'alt-p: toggle description, alt-j/k: scroll description, tab: multi-select' \
                --preview-label-pos 'bottom' \
                --preview-window 'down:55%:wrap' \
                --bind 'alt-p:toggle-preview' \
                --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
                --bind 'alt-k:preview-up,alt-j:preview-down' \
                --color 'pointer:green,marker:green'
        ) || return 0

        if [ -n "$pkg_selection" ]; then
            pkg_ids=$(printf '%s\n' "$pkg_selection" | cut -f1 | tr '\n' ' ')

            gum style --foreground 10 "▸ Installing Flatpak packages..."

            if flatpak install --assumeyes $pkg_ids; then
                gum style --foreground 10 "✓ Installation complete!"
            else
                gum style --foreground 9 "x Installation failed."
            fi
        fi
    else
        gum style --foreground 9 "x Flatpak is not available on this system."
    fi
}

update_packages() {
    for cmd in gum yay; do
        _ensure_command "$cmd"
    done

    gum style --foreground 10 "▸ Authenticating..."

    if ! start_sudo_keepalive; then
        gum style --foreground 9 "x Authentication failed."
        return 1
    fi
    trap 'stop_sudo_keepalive' 0
    echo

    gum style --foreground 10 "▸ Updating Arch and AUR packages..."

    if yay -Syu; then
        # yay -Syu = yay --sync --refresh --sysupgrade
        update_db

        gum style --foreground 10 "✓ Arch and AUR packages updated!"
    else
        gum style --foreground 9 "x Arch and AUR package update failed."
    fi

    stop_sudo_keepalive
    trap - 0

    # Flatpak does not require sudo
    if command -v flatpak >/dev/null 2>&1; then
        echo
        gum style --foreground 10 "▸ Updating Flatpak packages..."

        if flatpak update --assumeyes; then
            gum style --foreground 10 "✓ Flatpak packages updated!"
        else
            gum style --foreground 9 "x Flatpak package update failed."
        fi
    fi

    # Homebrew does not require sudo
    if command -v brew >/dev/null 2>&1; then
        echo
        gum style --foreground 10 "▸ Updating Homebrew packages..."

        if brew upgrade; then
            gum style --foreground 10 "✓ Homebrew packages updated!"
        else
            gum style --foreground 9 "x Homebrew package update failed."
        fi
    fi
}

remove_packages() {
    for cmd in gum fzf yay; do
        _ensure_command "$cmd"
    done

    TAB_CHAR=$(printf '\t')

    # entry format: "[display type] - \t - internal type - \t - package name"
    # Internal type is for separating homebrew casks and formulae. It is not displayed.
    entries=$(
        {
            yay -Qeqn | awk '{print "[arch]\tarch\t" $0}'
            yay -Qeqm | awk '{print "[aur]\taur\t" $0}'

            if command -v flatpak >/dev/null 2>&1; then
                flatpak list --app --columns=application | awk '{print "[flatpak]\tflatpak\t" $0}'
            fi

            if command -v brew >/dev/null 2>&1; then
                brew list --formula --installed-on-request | awk '{print "[brew]\tformula\t" $0}'

                brew list --cask | awk '{print "[brew]\tcask\t" $0}'
            fi
        } | sort -t"$TAB_CHAR" -k3,3 -f
    )

    selected=$(
        printf '%s\n' "$entries" |
        fzf \
            --multi \
            --delimiter "$TAB_CHAR" \
            --with-nth 1,3 \
            --preview '
                case {1} in
                    "[arch]"|"[aur]")
                        yay -Qi -- {3}
                        ;;
                    "[flatpak]")
                        flatpak info {3}
                        ;;
                    "[brew]")
                        case {2} in
                            formula)
                                brew info --formula {3}
                                ;;
                            cask)
                                brew info --cask {3}
                                ;;
                        esac
                        ;;
                esac
            ' \
            --preview-label 'alt-p: toggle description, alt-j/k: scroll description, tab: multi-select' \
            --preview-label-pos 'bottom' \
            --preview-window 'down:55%:wrap' \
            --bind 'alt-p:toggle-preview' \
            --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
            --bind 'alt-k:preview-up,alt-j:preview-down' \
            --color 'pointer:red,marker:red'
    ) || return 0

    [ -z "$selected" ] && return 0

    pacman_pkgs=$(
        printf '%s\n' "$selected" |
        awk -F '\t' '$1 == "[arch]" || $1 == "[aur]" { print $3 }' |
        tr '\n' ' '
    )

    flatpak_pkgs=$(
        printf '%s\n' "$selected" |
        awk -F '\t' '$1 == "[flatpak]" { print $3 }' |
        tr '\n' ' '
    )

    homebrew_formulae=$(
        printf '%s\n' "$selected" |
        awk -F '\t' '$1 == "[brew]" && $2 == "formula" { print $3 }' |
        tr '\n' ' '
    )

    homebrew_casks=$(
        printf '%s\n' "$selected" |
        awk -F '\t' '$1 == "[brew]" && $2 == "cask" { print $3 }' |
        tr '\n' ' '
    )

    if [ -n "$pacman_pkgs" ]; then
        gum style --foreground 10 "▸ Authenticating..."

        if ! start_sudo_keepalive; then
            gum style --foreground 9 "x Authentication failed."
            return 1
        fi

        trap 'stop_sudo_keepalive' 0
        echo
    fi

    success=true

    if [ -n "$pacman_pkgs" ]; then
        gum style --foreground 10 "▸ Removing Arch/AUR packages..."

        if yay -Rns --noconfirm $pacman_pkgs; then
            gum style --foreground 10 "✓ Arch/AUR packages removed!"
        else
            gum style --foreground 9 "x Arch/AUR removal failed."
            success=false
        fi
        echo
    fi

    # Flatpak & Homebrew don't require sudo, so only authenticate for Arch/AUR removals.
    stop_sudo_keepalive
    trap - 0

    if [ -n "$flatpak_pkgs" ]; then
        gum style --foreground 10 "▸ Removing Flatpak packages..."

        if flatpak uninstall --assumeyes $flatpak_pkgs; then
            gum style --foreground 10 "✓ Flatpak packages removed!"
        else
            gum style --foreground 9 "x Flatpak removal failed."
            success=false
        fi
        echo
    fi

    if [ -n "$homebrew_formulae" ]; then
        gum style --foreground 10 "▸ Removing Homebrew formulae..."

        if brew uninstall --formula $homebrew_formulae; then
            gum style --foreground 10 "✓ Homebrew formulae removed!"
        else
            gum style --foreground 9 "x Homebrew formula removal failed."
            success=false
        fi
        echo
    fi

    if [ -n "$homebrew_casks" ]; then
        gum style --foreground 10 "▸ Removing Homebrew casks..."
        echo

        if brew uninstall --cask $homebrew_casks; then
            gum style --foreground 10 "✓ Homebrew casks removed!"
        else
            gum style --foreground 9 "x Homebrew cask removal failed."
            success=false
        fi
        echo
    fi


    $success
}

remove_unused_packages() {
    _ensure_command gum

    gum style --foreground 10 "▸ Removing unused Arch/AUR packages..."

    orphans=$(pacman -Qdtq || true)

    if [ -z "$orphans" ]; then
        gum style --foreground 10 "✓ No unused Arch/AUR packages found!"
    elif printf '%s\n' "$orphans" | sudo pacman -Rns --noconfirm -; then
        gum style --foreground 10 "✓ Unused Arch/AUR packages removed!"
    else
        gum style --foreground 9 "x Removing unused Arch/AUR packages failed."
    fi

    if command -v flatpak >/dev/null 2>&1; then
        echo
        gum style --foreground 10 "▸ Removing unused Flatpak packages..."

        if flatpak uninstall --system --unused --assumeyes; then
            gum style --foreground 10 "✓ Unused Flatpak packages removed!"
        else
            gum style --foreground 9 "x Removing unused Flatpak packages failed."
        fi

        if flatpak uninstall --user --unused --assumeyes; then
            gum style --foreground 10 "✓ Unused Flatpak user packages removed!"
        else
            gum style --foreground 9 "x Removing unused Flatpak user packages failed."
        fi
    fi

    if command -v brew >/dev/null 2>&1; then
        echo
        gum style --foreground 10 "▸ Removing unused Homebrew packages..."

        if brew cleanup; then
            gum style --foreground 10 "✓ Unused Homebrew packages removed!"
        else
            gum style --foreground 9 "x Removing unused Homebrew packages failed."
        fi
    fi
}


## ===
main() {
    if [ "$#" -eq 0 ]; then
        show_help
        return
    fi

    case "${1:-}" in
        install)
            case "${2:-}" in
                arch)
                    install_arch_packages
                    ;;
                aur)
                    install_aur_packages
                    ;;
                flatpak)
                    install_flatpak_packages
                    ;;
                *)
                    echo "Unknown install action: ${2:-}"
                    show_help
                    exit 1
                    ;;
            esac
            ;;
        update)
            update_packages
            ;;
        remove)
            remove_packages
            ;;
        remove-unused)
            remove_unused_packages
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
