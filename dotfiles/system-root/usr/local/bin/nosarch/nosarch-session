#!/bin/sh
# Managed by NosArch
# nosarch:summary=Lock, log out, restart, shutdown, and manage idle-lock

set -eu

show_help() {
    cat <<EOF
Usage:
    nosarch-session <command> [action]

Commands:
    idle-lock <action>      Manage Idle-lock
    lock                    Lock the session
    logout                  Log out of the session
    restart                 Restart the system
    shutdown                Shutdown the system
    help                    Show this help message

Idle-Lock actions:
    toggle                  Toggle Idle-Lock on/off
    enable                  Enable Idle-Lock
    disable                 Disable idle-lock
    status                  Check idle-lock state (outputs "true" if enabled, "false" otherwise)
        status-waybar           Check idle-lock state (outputs JSON for waybar)
EOF
}

## === Utilities ===
_ensure_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Error: $1 is required but not found."
        exit 1
    fi
}

_check_display() {
    if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ "${XDG_SESSION_TYPE:-}" = "x11" ] || [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
        echo "true"
    else
        echo "false"
    fi
}

# Echoes "<uid> <username>" for the active graphical session, or nothing if
# there is none. Both are needed: runuser resolves users by name, while
# XDG_RUNTIME_DIR is addressed by UID.
_graphical_session() {
    loginctl list-sessions --no-legend 2>/dev/null | while read -r session_id uid username _; do
        state=$(loginctl show-session "$session_id" --property=State --value 2>/dev/null)
        type=$(loginctl show-session "$session_id" --property=Type --value 2>/dev/null)

        if [ "$state" = "active" ] && { [ "$type" = "wayland" ] || [ "$type" = "x11" ]; }; then
            echo "$uid $username"
            break
        fi
    done
}

# Variables a graphical session needs for hyprctl, zenity and `systemctl --user`
# to find it. Used as a grep alternation, so keep pipe-separated.
_SESSION_ENV_KEYS="DBUS_SESSION_BUS_ADDRESS|DISPLAY|HYPRLAND_INSTANCE_SIGNATURE|WAYLAND_DISPLAY|XAUTHORITY|XDG_RUNTIME_DIR|XDG_SESSION_TYPE"

# Re-runs this script as the owner of the active graphical session. Does not return.
#
# Root has no session of its own, so `systemctl --user` talks to root's manager,
# hyprctl cannot find a compositor socket, and zenity has no display. Root
# callers (decman, udev rules) would otherwise skip hyprshutdown for text prompts.
_reexec_in_graphical_session() {
    session=$(_graphical_session)

    if [ -z "${session:-}" ]; then
        echo "Error: no active graphical session to run '$1' in." >&2
        exit 1
    fi

    session_uid=${session% *}
    session_user=${session#* }

    # The session's systemd user manager holds these because of `import-environment`
    # in the Hyprland's autostart config. Reading them back is exact. Reconstructing
    # them from $XDG_RUNTIME_DIR would mean guessing at WAYLAND_DISPLAY and the
    # Hyprland instance signature, and the compositor's own environment does not
    # carry either -- it exports them to its children rather than to itself.
    session_env=$(runuser --user "$session_user" -- \
        env "XDG_RUNTIME_DIR=/run/user/$session_uid" \
        systemctl --user show-environment 2>/dev/null |
        grep -E "^($_SESSION_ENV_KEYS)=") || true

    script_path=$0
    case "$script_path" in
        /*) ;;
        *) script_path=$(command -v "$0" || echo "/usr/local/bin/nosarch/nosarch-session") ;;
    esac

    # Split $session_env on newlines alone so values containing spaces survive.
    # "$@" is expanded before `set` reassigns it, so the original arguments end
    # up after the assignments and the script path, which is the order env
    # expects. XDG_RUNTIME_DIR is repeated in case the manager did not export it.
    old_ifs=$IFS
    IFS="
"
    # shellcheck disable=SC2086
    set -- $session_env "XDG_RUNTIME_DIR=/run/user/$session_uid" "$script_path" "$@"
    IFS=$old_ifs

    exec runuser --user "$session_user" -- env "$@"
}

## === Features ===
IDLE_LOCK_UNIT="nosarch-idle-inhibit.service"

enable_idle_lock() {
    ## TODO: Second line: use IDLE_LOCK_UNIT in the --unit argument as well
    systemd-run --user \
        --unit=nosarch-idle-inhibit \
        --description="NosArch Idle Inhibition (Manual Toggle)" \
        /usr/bin/systemd-inhibit --what=idle --who="Manual Toggle" --why="User requested" sleep infinity

    notify-send --urgency=low --transient \
      --app-name="NosArch Power" \
      "󰅶  Enabled Idle Lock" "Stop locking computer when idle"

    pkill -RTMIN+8 waybar # Update the waybar idlelock module
}
disable_idle_lock() {
    systemctl --user stop "$IDLE_LOCK_UNIT"
    notify-send --urgency=low --transient \
      --app-name="NosArch Power" \
      "󰾪  Disabled Idle Lock" "Now locking computer when idle"

    pkill -RTMIN+8 waybar # Update the waybar idlelock module
}
toggle_idle_lock() {
    if systemctl --user is-active --quiet "$IDLE_LOCK_UNIT"; then
        disable_idle_lock
    else
        enable_idle_lock
    fi
}
idle_lock_status() {
    if systemctl --user is-active --quiet "$IDLE_LOCK_UNIT"; then
        echo "true"
    else
        echo "false"
    fi
}
idle_lock_status_waybar() {
    if systemctl --user is-active --quiet "$IDLE_LOCK_UNIT"; then
        echo '{"alt": "enabled", "tooltip": "Disable Idle Lock", "class": "enabled"}'
    else
        echo '{"alt": "disabled", "tooltip": "Enable Idle Lock", "class": "disabled"}'
    fi
}

session_lock() {
    # Close Bitwarden if installed
    if command -v bitwarden >/dev/null 2>&1; then
        pkill -i bitwarden
    fi

    # Set keyboard layout to default (first layout)
    hyprctl switchxkblayout all 0 > /dev/null 2>&1

    # Stop the eyesight reminder timer
    nosarch-wellbeing eyesight stop

    # Lock the screen (use lock helper script to avoid blocking)
    if ! pidof hyprlock >/dev/null; then
        setsid bash /usr/local/bin/util/nosarch-lock-helper.sh >/dev/null 2>&1 &
    fi
}
session_after_unlock() {
    # Start the eyesight reminder timer if enabled

    if [ "$(nosarch-wellbeing eyesight status)" = "true" ]; then
        nosarch-wellbeing eyesight start
    fi
}

session_logout() {
    if [ "$(_check_display)" = "true" ]; then
        _ensure_command "hyprshutdown"
        _ensure_command "zenity"

        if zenity --question \
            --title="Logout" \
            --text="Are you sure you want to quit all applications and log out now?" \
            --icon="system-log-out-symbolic" \
            --ok-label="Logout" \
            --cancel-label="Cancel" \
            --default-cancel
        then
            CMD="hyprshutdown --top-label 'Logging out...' --post-cmd 'uwsm stop'"
            hyprctl eval "hl.exec_cmd([==[$CMD]==])"
        fi
    else
        printf "Are you sure you want to log out now? [y/N]: "
        read -r response
        case "$response" in
            [yY])
                uwsm stop
                ;;
            *)
                return
                ;;
        esac
    fi
}

system_shutdown() {
    if [ "$(_check_display)" = "true" ]; then
        _ensure_command "hyprshutdown"
        _ensure_command "zenity"

        if zenity --question \
            --title="Shutdown" \
            --text="Are you sure you want to shutdown your computer now?" \
            --icon="system-shutdown-symbolic" \
            --ok-label="Shutdown" \
            --cancel-label="Cancel" \
            --default-cancel
        then
            CMD="hyprshutdown --top-label 'Shutting down...' --post-cmd 'systemctl poweroff --no-wall'"
            hyprctl eval "hl.exec_cmd([==[$CMD]==])"
        fi
    else
        printf "Are you sure you want to shutdown your computer now? [y/N]: "
        read -r response
        case "$response" in
            [yY])
                systemctl poweroff --no-wall
                ;;
            *)
                return
                ;;
        esac
    fi
}

system_restart() {
    if [ "$(_check_display)" = "true" ]; then
        _ensure_command "hyprshutdown"
        _ensure_command "zenity"

        if zenity --question \
            --title="Restart" \
            --text="Are you sure you want to restart your computer now?" \
            --icon="system-reboot-symbolic" \
            --ok-label="Restart" \
            --cancel-label="Cancel" \
            --default-cancel
        then
            CMD="hyprshutdown --top-label 'Restarting...' --post-cmd 'systemctl reboot --no-wall'"
            hyprctl eval "hl.exec_cmd([==[$CMD]==])"
        fi
    else
        printf "Are you sure you want to restart your computer now? [y/N]: "
        read -r response
        case "$response" in
            [yY])
                systemctl reboot --no-wall
                ;;
            *)
                return
                ;;
        esac
    fi
}

## ===
main() {
    if [ "$#" -eq 0 ]; then
        show_help
        return
    fi

    # Every command except help acts on the graphical session, so hand the
    # invocation over to it when there is no session here to act on.
    case "${1:-}" in
        help|-h|--help) ;;
        *)
            if [ "$(id -u)" -eq 0 ]; then
                _reexec_in_graphical_session "$@"
            fi
            ;;
    esac

    case "${1:-}" in
        idle-lock)
            case "${2:-}" in
                toggle)
                    toggle_idle_lock
                    ;;
                enable)
                    enable_idle_lock
                    ;;
                disable)
                    disable_idle_lock
                    ;;
                status)
                    idle_lock_status
                    ;;
                status-waybar)
                    idle_lock_status_waybar
                    ;;
                *)
                    echo "Unknown idle-lock action: $2"
                    show_help
                    exit 1
                    ;;
            esac
            ;;
        lock)
            session_lock
            ;;
        logout)
            session_logout
            ;;
        restart)
            system_restart
            ;;
        shutdown)
            system_shutdown
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
