#!/bin/sh
# Managed by NosArch

set -eu

show_help() {
    cat <<EOF
Usage:
    nosarch-session <command> [action]

Commands:
    idle-lock <action>      Manage Idle-lock
    lock                    Lock the session
    logout                  Log out of the session
    restart                 Restart the system
    shutdown                Shutdown the system
    help                    Show this help message

Idle-Lock actions:
    toggle                  Toggle Idle-Lock on/off
    enable                  Enable Idle-Lock
    disable                 Disable idle-lock
    status                  Check idle-lock state (outputs "true" if enabled, "false" otherwise)
        status-waybar           Check idle-lock state (outputs JSON for waybar)
EOF
}

## === Utilities ===
_ensure_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Error: $1 is required but not found."
        exit 1
    fi
}

_check_display() {
    if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ "${XDG_SESSION_TYPE:-}" = "x11" ] || [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
        echo "true"
    else
        echo "false"
    fi
}

## === Features ===
IDLE_LOCK_UNIT="nosarch-idle-inhibit.service"

enable_idle_lock() {
    ## TODO: Second line: use IDLE_LOCK_UNIT in the --unit argument as well
    systemd-run --user \
        --unit=nosarch-idle-inhibit \
        --description="NosArch Idle Inhibition (Manual Toggle)" \
        /usr/bin/systemd-inhibit --what=idle --who="Manual Toggle" --why="User requested" sleep infinity

    notify-send --urgency=low --transient \
      --app-name="NosArch Power" \
      "󰅶  Enabled Idle-Lock" "Stop locking computer when idle"

    pkill -RTMIN+8 waybar # Update the waybar idlelock module
}
disable_idle_lock() {
    systemctl --user stop "$IDLE_LOCK_UNIT"
    notify-send --urgency=low --transient \
      --app-name="NosArch Power" \
      "󰾪  Disabled Idle-Lock" "Now locking computer when idle"

    pkill -RTMIN+8 waybar # Update the waybar idlelock module
}
toggle_idle_lock() {
    if systemctl --user is-active --quiet "$IDLE_LOCK_UNIT"; then
        disable_idle_lock
    else
        enable_idle_lock
    fi
}
idle_lock_status() {
    if systemctl --user is-active --quiet "$IDLE_LOCK_UNIT"; then
        echo "true"
    else
        echo "false"
    fi
}
idle_lock_status_waybar() {
    if systemctl --user is-active --quiet "$IDLE_LOCK_UNIT"; then
        echo '{"alt": "enabled", "tooltip": "Disable Idle Lock", "class": "enabled"}'
    else
        echo '{"alt": "disabled", "tooltip": "Enable Idle Lock", "class": "disabled"}'
    fi
}

session_lock() {
    # Close Bitwarden if installed
    if command -v bitwarden >/dev/null 2>&1; then
        pkill -i bitwarden
    fi

    # Set keyboard layout to default (first layout)
    hyprctl switchxkblayout all 0 > /dev/null 2>&1

    # Stop the eyesight reminder timer
    nosarch-wellbeing eyesight stop

    # Lock the screen (use lock helper script to avoid blocking)
    if ! pidof hyprlock >/dev/null; then
        setsid bash /usr/local/bin/util/nosarch-lock-helper.sh >/dev/null 2>&1 &
    fi
}
session_after_unlock() {
    # Start the eyesight reminder timer if enabled

    if [ "$(nosarch-wellbeing eyesight status)" = "true" ]; then
        nosarch-wellbeing eyesight start
    fi
}

session_logout() {
    uwsm stop
}
session_logout_prompt() {
    if [ "$(_check_display)" = "true" ]; then
        _ensure_command "hyprshutdown"
        _ensure_command "zenity"

        if zenity --question \
            --title="Logout" \
            --text="Are you sure you want to quit all applications and log out now?" \
            --icon="system-log-out-symbolic" \
            --ok-label="Logout" \
            --cancel-label="Cancel" \
            --default-cancel
        then
            CMD="hyprshutdown --top-label 'Logging out...' --post-cmd 'session_logout'"
            hyprctl eval "hl.exec_cmd([==[$CMD]==])"
        fi
    else
        printf "Are you sure you want to log out now? [y/N]: "
        read -r response
        case "$response" in
            [yY])
                session_logout
                ;;
            *)
                return
                ;;
        esac
    fi
}

system_shutdown() {
    systemctl poweroff --no-wall
}
system_shutdown_prompt() {
    if [ "$(_check_display)" = "true" ]; then
        _ensure_command "hyprshutdown"
        _ensure_command "zenity"

        if zenity --question \
            --title="Shutdown" \
            --text="Are you sure you want to shutdown your computer now?" \
            --icon="system-shutdown-symbolic" \
            --ok-label="Shutdown" \
            --cancel-label="Cancel" \
            --default-cancel
        then
            CMD="hyprshutdown --top-label 'Shutting down...' --post-cmd 'system_shutdown'"
            hyprctl eval "hl.exec_cmd([==[$CMD]==])"
        fi
    else
        printf "Are you sure you want to shutdown your computer now? [y/N]: "
        read -r response
        case "$response" in
            [yY])
                system_shutdown
                ;;
            *)
                return
                ;;
        esac
    fi
}

system_restart() {
    systemctl reboot --no-wall
}
system_restart_prompt() {
    if [ "$(_check_display)" = "true" ]; then
        _ensure_command "hyprshutdown"
        _ensure_command "zenity"

        if zenity --question \
            --title="Restart" \
            --text="Are you sure you want to restart your computer now?" \
            --icon="system-reboot-symbolic" \
            --ok-label="Restart" \
            --cancel-label="Cancel" \
            --default-cancel
        then
            CMD="hyprshutdown --top-label 'Restarting...' --post-cmd 'system_restart'"
            hyprctl eval "hl.exec_cmd([==[$CMD]==])"
        fi
    else
        printf "Are you sure you want to restart your computer now? [y/N]: "
        read -r response
        case "$response" in
            [yY])
                system_restart
                ;;
            *)
                return
                ;;
        esac
    fi
}

## ===
main() {
    if [ "$#" -eq 0 ]; then
        show_help
        return
    fi

    case "${1:-}" in
        idle-lock)
            case "${2:-}" in
                toggle)
                    toggle_idle_lock
                    ;;
                enable)
                    enable_idle_lock
                    ;;
                disable)
                    disable_idle_lock
                    ;;
                status)
                    idle_lock_status
                    ;;
                status-waybar)
                    idle_lock_status_waybar
                    ;;
                *)
                    echo "Unknown idle-lock action: $2"
                    show_help
                    exit 1
                    ;;
            esac
            ;;
        lock)
            session_lock
            ;;
        logout)
            session_logout_prompt
            ;;
        restart)
            system_restart_prompt
            ;;
        shutdown)
            system_shutdown_prompt
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
