#!/bin/bash

show_help() {
    cat <<EOF
Usage: nosarch-volume <command> [option]

Commands:
    help        Show this help message and exit
    input       Control input volume [set | increase | decrease | mute]
    output      Control output volume [set | increase | decrease | mute]

[output | input] options:
    set         Set the volume to a specific value [0-100]%
    increase    Increase the volume by [INT] (default 5%)
    decrease    Decrease the volume by [INT] (default 5%)
    mute        Mute the volume [toggle | enable | disable]
EOF
}

# === Output control ===
set_output_volume() {
    wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ "${1}%"
}

increase_output_volume() {
    # if [[ -z "${1}" ]]; then
    #     swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --output-volume raise
    # else
    #     swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --output-volume "+${1}"
    # fi

    wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ "${1:-5}"%+
}

decrease_output_volume() {
    # if [[ -z "${1}" ]]; then
    #     swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --output-volume lower
    # else
    #     swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --output-volume "-${1}"
    # fi

    wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ "${1:-5}"%-
}

get_output_volume() {
    output=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)

    # Expected output from above command (e.g. for 20% volume): `Volume: 0.20`
    echo $((10#${output##*.}))
}

# === Input control ===
set_input_volume() {
    wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SOURCE@ "${1}%"
}

increase_input_volume() {
    # if [[ -z "${1}" ]]; then
    #     swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --input-volume raise
    # else
    #     swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --input-volume "+${1}"
    # fi

    wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SOURCE@ "${1:-5}"%+
}

decrease_input_volume() {
    # if [[ -z "${1}" ]]; then
    #     swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --input-volume lower
    # else
    #     swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --input-volume "-${1}"
    # fi

    wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SOURCE@ "${1:-5}"%-
}

get_input_volume() {
    volume=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)

    # Expected output from above command (e.g. for 20% volume): `Volume: 0.20`
    echo $((10#${volume##*.}))
}

## === Main logic ===
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        return
    fi

    case "${1:-}" in
        output)
            case "${2:-}" in
                set)
                    if [[ $# -ne 3 ]]; then
                        show_help
                        return
                    fi

                    set_output_volume "${3}"
                    ;;
                increase)
                    increase_output_volume "${3:-}"
                    ;;
                decrease)
                    decrease_output_volume "${3:-}"
                    ;;
                mute)
                    case "${3:-}" in
                        toggle)
                            # swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --output-volume mute-toggle
                            wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
                            ;;
                        enable)
                            wpctl set-mute @DEFAULT_AUDIO_SINK@ 1
                            ;;
                        disable)
                            wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
                            ;;
                        *)
                            echo "Unknown mute command: $3"
                            show_help
                            exit 1
                            ;;
                    esac
                    ;;
                get)
                    get_output_volume
                    ;;
            esac
            ;;
        input)
            case "${2:-}" in
                set)
                    if [[ $# -ne 3 ]]; then
                        show_help
                        return
                    fi

                    set_input_volume "${3}"
                    ;;
                increase)
                    increase_input_volume "${3:-}"
                    ;;
                decrease)
                    decrease_input_volume "${3:-}"
                    ;;
                mute)
                    case "${3:-}" in
                        toggle)
                            # swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --input-volume mute-toggle
                            wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
                            ;;
                        enable)
                            wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1
                            ;;
                        disable)
                            wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
                            ;;
                        *)
                            echo "Unknown mute command: $3"
                            show_help
                            exit 1
                            ;;
                    esac
                    ;;
                get)
                    get_input_volume
                    ;;
            esac
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
