// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
    "$schema": "https://vicinae.com/schemas/config.json",
    "telemetry": {
        "system_info": false
    },
    "input_server": {
        "enabled": true
    },
    "search_files_in_root": false,
    "activate_on_single_click": false,
    "escape_key_behavior": "close_window",
    "pop_on_backspace": true,
    "close_on_focus_loss": false,
    "consider_preedit": false,
    "pop_to_root_on_close": true,
    "favicon_service": "twenty",
    "keybinding": "default",
    "font": {
        "rendering": "native",
        "normal": {
            "family": "Adwaita Sans",
            "size": 10.5
        }
    },
    "theme": {
        "dark": {
            "name": "vicinae-dark",
            "icon_theme": "Adwaita"
        }
    },
    "launcher_window": {
        "opacity": 0.95,
        "blur": {
            "enabled": true
        },
        "client_side_decorations": {
            "enabled": true,
            "rounding": 10,
            "border_width": 1,
            "shadow_size": 12
        },
        "compact_mode": {
            "enabled": false
        },
        "size": {
            "width": 770,
            "height": 480
        },
        "layer_shell": {
            "enabled": true,
            "keyboard_interactivity": "exclusive",
            "layer": "top"
        }
    },
    "pixmap_cache_mb": 50,
    "keybinds": {
        "toggle-action-panel": "control+RETURN"
    },
    "favorites": [
        "@abdulk-id/custom-menus:open-menu",
        "applications:webcord",
        "applications:zen",
        "applications:dev.zed.Zed",
        "applications:io.github.alainm23.planify"
    ],
    "fallbacks": [
        "files:search",
        "shortcuts:f9700258-5b9e-41f2-b36d-e488d8e3ff46",
        "shortcuts:e9986be3-a5d4-400a-af12-404752b70970"
    ],
    "providers": {
        "@abdulk-id/custom-menus": {
            "entrypoints": {
                "open-menu": {
                    "alias": "NosArch"
                }
            }
        },
        "applications": {
            "enabled": true,
            "preferences": {
                "defaultAction": "focus",
                "paths": [
                    "/home/%USER%/.local/share/applications",
                    "/home/%USER%/.local/share/flatpak/exports/share/applications",
                    "/var/lib/flatpak/exports/share/applications",
                    "/usr/local/share/applications",
                    "/usr/share/applications"
                ]
            },
            "entrypoints": {
                "vicinae": {
                    "enabled": false
                }
            }
        },
        "browser-extension": {
            "enabled": false
        },
        "calculator": {
            "entrypoints": {
                "refresh-rates": {
                    "enabled": true
                }
            }
        },
        "clipboard": {
            "preferences": {
                "encryption": false,
                "eraseOnStartup": false,
                "ignorePasswords": true,
                "monitoring": true
            },
            "entrypoints": {
                "clear": {
                    "enabled": false
                },
                "clear-history": {
                    "enabled": false
                }
            }
        },
        "core": {
            "entrypoints": {
                "about": {
                    "enabled": false
                },
                "documentation": {
                    "enabled": false
                },
                "inspect-local-storage": {
                    "enabled": false
                },
                "keybind-settings": {
                    "enabled": false
                },
                "list-extensions": {
                    "enabled": false
                },
                "manage-fallback": {
                    "enabled": false
                },
                "oauth-token-store": {
                    "enabled": false
                },
                "open-config-file": {
                    "enabled": false
                },
                "open-default-config": {
                    "enabled": false
                },
                "prune-memory": {
                    "enabled": false
                },
                "refresh-apps": {
                    "enabled": false
                },
                "reload-scripts": {
                    "enabled": false
                },
                "report-bug": {
                    "enabled": false
                },
                "search-builtin-icons": {
                    "enabled": false
                },
                "search-emojis": {
                    "enabled": false
                },
                "sponsor": {
                    "enabled": false
                },
                "store": {
                    "enabled": true
                }
            }
        },
        "developer": {
            "enabled": false
        },
        "files": {
            "preferences": {
                "autoIndexing": true,
                "excludedPaths": "/home/%USER%/Codespace",
                "paths": "/home/%USER%",
                "watcherPaths": ""
            },
            "entrypoints": {
                "rebuild-index": {
                    "enabled": false
                }
            }
        },
        "font": {
            "enabled": false
        },
        "manage-shortcuts": {
            "entrypoints": {
                "manage": {
                    "enabled": false
                }
            }
        },
        "power": {
            "enabled": true,
            "entrypoints": {
                "hibernate": {
                    "enabled": false
                },
                "lock": {
                    "enabled": true,
                    "preferences": {
                        "confirm": false,
                        "customProgram": "nosarch-session lock"
                    }
                },
                "logout": {
                    "enabled": true,
                    "preferences": {
                        "confirm": false,
                        "customProgram": "nosarch-session logout"
                    }
                },
                "power-off": {
                    "alias": "Shutdown System",
                    "enabled": true,
                    "preferences": {
                        "confirm": false,
                        "customProgram": "nosarch-session shutdown"
                    }
                },
                "reboot": {
                    "alias": "Restart System",
                    "enabled": true,
                    "preferences": {
                        "confirm": false,
                        "customProgram": "nosarch-session restart"
                    }
                },
                "sleep": {
                    "enabled": false
                },
                "soft-reboot": {
                    "enabled": false
                },
                "suspend": {
                    "enabled": true,
                    "preferences": {
                        "confirm": true,
                        "customProgram": ""
                    }
                }
            }
        },
        "raycast-compat": {
            "enabled": false
        },
        "scripts": {
            "enabled": false
        },
        "shortcuts": {
            "enabled": true
        },
        "snippets": {
            "enabled": false
        },
        "system": {
            "entrypoints": {
                "browse-apps": {
                    "enabled": false
                },
                "run": {
                    "preferences": {
                        "default-action": "run"
                    }
                },
                "toggle-mute": {
                    "enabled": false
                },
                "volume-0": {
                    "enabled": false
                },
                "volume-100": {
                    "enabled": false
                },
                "volume-25": {
                    "enabled": false
                },
                "volume-50": {
                    "enabled": false
                },
                "volume-75": {
                    "enabled": false
                },
                "volume-down": {
                    "enabled": false
                },
                "volume-up": {
                    "enabled": false
                }
            }
        },
        "theme": {
            "enabled": false
        },
        "wm": {
            "enabled": false
        }
    }
}
