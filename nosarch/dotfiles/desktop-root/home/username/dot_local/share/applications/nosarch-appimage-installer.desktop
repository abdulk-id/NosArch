# Managed by NosArch
# Exec is absolute, with no shell. A file manager does not set the working directory a relative
# path would need, and a sh -c wrapper would have to escape the characters this spec reserves.

[Desktop Entry]
Type=Application
Name=Install AppImage
Comment=Install an AppImage application
Exec=/usr/local/bin/nosarch/nosarch-package install appimage --confirm %F
Icon=system-software-install
Terminal=false
NoDisplay=false
MimeType=application/x-appimage;application/x-iso9660-appimage;
Categories=System;PackageManager;
