{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "read": {
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow",
            "*": "allow",
        },
        "edit": {
            "LICENSE": "deny",
            ".zed/*": "ask",
            ".editorconfig": "ask",
            ".gitignore": "ask",
            ".ruff.toml": "ask",
            "CODE_STYLE.md": "ask",
            "CONTRIBUTING.md": "ask",
            "opencode.jsonc": "ask",
            "README.md": "ask",
            "*": "allow",
        },
        "glob": "allow",
        "grep": "allow",
        "bash": {
            "sudo *": "deny",
            "*": "ask",
        },
        "task": "allow",
        "skill": "allow",
        "lsp": "allow",
        "question": "allow",
        "webfetch": "ask",
        "websearch": "allow",
        "external_directory": "ask",
        "doom_loop": "deny",
    },
}
