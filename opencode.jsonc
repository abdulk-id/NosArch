{
    "$schema": "https://opencode.ai/config.json",
    "permissions": [
        // read
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        // edit
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": ".zed/*", "effect": "ask" },
        { "action": "edit", "resource": ".editorconfig", "effect": "ask" },
        { "action": "edit", "resource": ".gitignore", "effect": "ask" },
        { "action": "edit", "resource": ".ruff.toml", "effect": "ask" },
        { "action": "edit", "resource": "CODE_STYLE.md", "effect": "ask" },
        { "action": "edit", "resource": "CONTRIBUTING.md", "effect": "ask" },
        { "action": "edit", "resource": "opencode.jsonc", "effect": "ask" },
        { "action": "edit", "resource": "README.md", "effect": "ask" },
        { "action": "edit", "resource": "LICENSE", "effect": "deny" },
        // shell
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git push *", "effect": "ask" },
        { "action": "shell", "resource": "sudo *", "effect": "deny" },
        // external_directory
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "/tmp/opencode", "effect": "allow" },
    ],
}
