// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    // General
    "when_closing_with_no_tabs": "platform_default",
    "on_last_window_closed": "platform_default",
    "use_system_path_prompts": true,
    "use_system_prompts": true,
    "redact_private_values": true,
    "session": {
        "trust_all_worktrees": false,
        "restore_unsaved_buffers": true,
    },
    "restore_on_startup": "last_session",
    // Privacy
    "telemetry": {
        "diagnostics": true,
        "metrics": false,
    },
    // Appearance
    "theme": {
        "mode": "system",
        "light": "Ayu Light",
        "dark": "One Dark",
    },
    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_size": 15.0,
    "buffer_font_weight": 400.0,
    "buffer_line_height": "comfortable",
    "buffer_font_features": {
        // Disable ligatures:
        "calt": false,
    },
    "ui_font_family": ".ZedSans",
    "ui_font_size": 17.0,
    "ui_font_weight": 400,
    "agent_ui_font_size": 16.0,
    "agent_buffer_font_size": 15.0,
    "text_rendering_mode": "platform_default",
    "show_wrap_guides": true,
    // Keymap
    "base_keymap": "JetBrains",
    // Editor
    "autosave": "off",
    "which_key": {
        "enabled": true,
        "delay_ms": 1000,
    },
    "scroll_beyond_last_line": "one_page",
    "auto_signature_help": true,
    "show_signature_help_after_edits": true,
    "scrollbar": {
        "show": "system",
    },
    "toolbar": {
        "code_actions": true,
    },
    "vim": {
        "toggle_relative_line_numbers": true,
    },
    "tab_size": 4,
    "hard_tabs": false,
    "auto_indent": "syntax_aware",
    "soft_wrap": "bounded",
    "preferred_line_length": 120,
    "indent_guides": {
        "coloring": "indent_aware",
        "background_coloring": "disabled",
    },
    "format_on_save": "on",
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "use_autoclose": true,
    "use_auto_surround": true,
    "always_treat_brackets_as_autoclosed": false,
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "completion_menu_scrollbar": "system",
    "completion_menu_item_kind": "symbol",
    "inlay_hints": {
        "enabled": true,
        "show_background": true,
    },
    "colorize_brackets": true,
    // Languages & Tools
    "diagnostics": {
        "include_warnings": true,
        "inline": {
            "enabled": true,
        },
    },
    // Search & Files
    "search_wrap": false,
    "search": {
        "center_on_match": true,
    },
    "seed_search_query_from_cursor": "selection",
    "close_on_file_delete": false,
    // Window & Layout
    "title_bar": {
        "show_branch_status_icon": true,
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_diagnostics": "all",
    },
    "tab_bar": {
        "show_pinned_tabs_in_separate_row": true,
    },
    // Panels
    "project_panel": {
        "dock": "left",
        "bold_folder_labels": false,
        "entry_spacing": "comfortable",
        "starts_open": true,
        "scrollbar": {
            "show": "system",
        },
        "diagnostic_badges": true,
    },
    "git_panel": {
        "tree_view": true,
        "fallback_branch_name": "master",
        "sort_by_path": true,
    },
    // Terminal
    "terminal": {
        "bell": "system",
    },
    // Collaboration
    "calls": {
        "mute_on_join": true,
    },
    // AI
    "disable_ai": false,
    "agent": {
        "default_profile": "ask",
        "default_model": {
            "provider": "opencode",
            "model": "minimax-m2.5-free",
            "enable_thinking": false,
        },
        "favorite_models": [
            {
                "provider": "opencode",
                "model": "minimax-m2.5-free",
                "enable_thinking": false,
            },
        ],
        "model_parameters": [],
        "play_sound_when_agent_done": "always",
        "single_file_review": true,
        "show_turn_stats": true,
    },
    "show_edit_predictions": true,
    "edit_predictions": {
        "mode": "subtle",
    },
}
