#!/bin/bash

set -euo pipefail

## === Actions Logic ===
show_help() {
    cat <<EOF
NosArch script to launch common apps

Usage:
    nosarch-launch-app <command>

Commands:
    browser             Launch the default browser
    browser-private     Launch the default browser in private mode
    editor              Launch the default editor
    files               Launch the file manager
    terminal            Launch the default terminal emulator
EOF
}

get_browser_exec() {
    # Copied from Omarchy

    local desktop
    desktop=$(xdg-settings get default-web-browser)

    sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
        {~/.local,~/.nix-profile,/usr}/share/applications/"$desktop" \
        2>/dev/null | head -1
}
get_private_flag() {
    # Copied from Omarchy

    local browser=$1

    if "$browser" --help | grep -q MOZ_LOG; then
        echo "--private-window"
    elif [[ $browser =~ edge ]]; then
        echo "--inprivate"
    else
        echo "--incognito"
    fi
}
launch_browser() {
    exec setsid uwsm-app -- "$(get_browser_exec)"
}
launch_browser_private() {
    local browser private_flag
    browser=$(get_browser_exec)
    private_flag=$(get_private_flag "$browser")

    exec setsid uwsm-app -- "$browser" "$private_flag"
}

## === Main logic ===
main() {
    case "${1:-}" in
        browser)
            launch_browser
            ;;
        browser-private)
            launch_browser_private
            ;;
        editor)
            exec setsid uwsm-app -- "$VISUAL"
            ;;
        files)
            exec setsid uwsm-app -- nautilus --new-window
            ;;
        terminal)
            exec setsid uwsm-app -- "$TERMINAL"
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
