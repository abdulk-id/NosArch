#!/bin/bash

set -euo pipefail

_ensure_command() {
    if ! command -v "$1" &>/dev/null; then
        echo "Error: $1 is required but not found."
        exit 1
    fi
}

for cmd in gum fzf yay; do
    _ensure_command "$cmd"
done


## === Actions logic ===
show_help() {
    cat <<EOF
Usage: nosarch-package <command> [option]

Commands:
    install         Install packages [arch | aur | flatpak]
    update          Update packages (Arch and AUR, and Flatpak if installed)
    remove          Remove packages
    remove-unused   Remove unused (orphan) packages

Install options:
    arch            Install packages from Arch repositories
    aur             Install packages from AUR
    flatpak         Install packages from Flatpak
EOF
}

install_arch_packages() {
    # Copied from Omarchy
    fzf_args=(
        --multi
        --preview 'pacman -Sii {1}'
        --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
        --preview-label-pos='bottom'
        --preview-window 'down:65%:wrap'
        --bind 'alt-p:toggle-preview'
        --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
        --bind 'alt-k:preview-up,alt-j:preview-down'
        --color 'pointer:green,marker:green'
    )

    # List all arch packages (names only)
    pkg_names=$(pacman -Slq | fzf "${fzf_args[@]}")

    if [[ "$pkg_names" != "" ]]; then
        mapfile -t pkg_array <<< "$pkg_names"

        gum style --foreground 2 --bold "▸ Installing packages..."

        echo
        if sudo pacman -S --needed "${pkg_array[@]}"; then
            if command -v updatedb &>/dev/null; then
                sudo updatedb
            fi

            echo
            gum style --foreground 2 "✓ Installation complete!"
        else
            echo
            gum style --foreground 9 "x Installation failed."
        fi
    fi
}

install_aur_packages() {
    # Copied from Omarchy
    fzf_args=(
        --multi
        --preview 'yay -Siia {1}'
        --preview-label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll, tab: multi-select'
        --preview-label-pos='bottom'
        --preview-window 'down:65%:wrap'
        --bind 'alt-p:toggle-preview'
        --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
        --bind 'alt-k:preview-up,alt-j:preview-down'
        --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
        --bind 'alt-B:change-preview:yay -Siia {1}'
        --color 'pointer:green,marker:green'
    )

    # List all AUR packages (names only)
    pkg_names=$(yay -Slqa | fzf "${fzf_args[@]}")

    if [[ "$pkg_names" != "" ]]; then
        mapfile -t pkg_array <<< "$pkg_names"

        gum style --foreground 2 --bold "▸ Installing AUR packages..."

        echo
        if yay -S "${pkg_array[@]}"; then
            if command -v updatedb &>/dev/null; then
                sudo updatedb
            fi

            echo
            gum style --foreground 2 "✓ Installation complete!"
        else
            echo
            gum style --foreground 9 "x Installation failed."
        fi
    fi
}

install_flatpak_packages() {
    fzf_args=(
        --multi
        --delimiter=$'\t'
        --with-nth=2
        --preview 'printf "%s\n" "{}" | cut -f3'
        --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
        --preview-label-pos='bottom'
        --preview-window 'down:30%:wrap'
        --bind 'alt-p:toggle-preview'
        --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
        --bind 'alt-k:preview-up,alt-j:preview-down'
        --color 'pointer:green,marker:green'
    )

    # APP_ID<TAB>NAME<TAB>DESCRIPTION
    pkg_selection=$(
        flatpak remote-ls --app --columns=application,name,description | \
        awk -F'\t' '
            !seen[$1]++ {
                printf "%s\t%s  (%s)\t%s\n", $1, $2, $1, $3
            }
        ' | sort -t$'\t' -k2,2f | fzf "${fzf_args[@]}"
    )

    if [[ -n "$pkg_selection" ]]; then
        mapfile -t pkg_array < <(
            printf '%s\n' "$pkg_selection" | cut -f1
        )

        gum style --foreground 2 --bold "▸ Installing Flatpak packages..."
        echo

        success=true
        for pkg in "${pkg_array[@]}"; do
            if ! flatpak install "$pkg"; then
                success=false
            fi
        done

        echo
        if $success; then
            gum style --foreground 2 "✓ Installation complete!"
        else
            gum style --foreground 9 "x Some installations failed."
        fi
    fi
}

update_packages() {
    gum style --foreground 2 --bold "▸ Updating Arch and AUR packages..."

    echo
    if yay -Syu; then
        if command -v updatedb &>/dev/null; then
            sudo updatedb
        fi

        echo
        gum style --foreground 2 "✓ Arch and AUR packages updated!"
    else
        echo
        gum style --foreground 9 "x Arch and AUR package update failed."
    fi

    if command -v flatpak &>/dev/null; then
        echo
        gum style --foreground 2 --bold "▸ Updating Flatpak packages..."

        if flatpak update --assumeyes; then
            echo
            gum style --foreground 2 "✓ Flatpak packages updated!"
        else
            echo
            gum style --foreground 9 "x Flatpak package update failed."
        fi
    fi
}

remove_packages() {
    # Copied from Omarchy
    fzf_args=(
        --multi
        --preview 'yay -Qi {1}'
        --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
        --preview-label-pos='bottom'
        --preview-window 'down:65%:wrap'
        --bind 'alt-p:toggle-preview'
        --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
        --bind 'alt-k:preview-up,alt-j:preview-down'
        --color 'pointer:red,marker:red'
    )

    # List all AUR packages (names only)
    pkg_names=$(yay -Qqe | fzf "${fzf_args[@]}")

    if [[ "$pkg_names" != "" ]]; then
        mapfile -t pkg_array <<< "$pkg_names"

        gum style --foreground 2 --bold "▸ Removing packages..."

        echo
        if yay -Rns "${pkg_array[@]}"; then
            echo
            gum style --foreground 2 "✓ Packages removed!"
        else
            echo
            gum style --foreground 9 "x Removal failed."
        fi
    fi
}

remove_unused_packages() {
    gum style --foreground 2 --bold "▸ Removing unused (orphan) packages..."
    echo

    if pacman -Qdtq | sudo pacman -Rns -; then
        echo
        gum style --foreground 2 "✓ Unused packages removed!"
    else
        echo
        gum style --foreground 9 "x Removal failed."
    fi
}


## === Main logic ===
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        return
    fi

    case "${1:-}" in
        install)
            case "${2:-}" in
                arch)
                    install_arch_packages
                    ;;
                aur)
                    install_aur_packages
                    ;;
                flatpak)
                    install_flatpak_packages
                    ;;
                *)
                    echo "Unknown command: $2"
                    show_help
                    exit 1
                    ;;
            esac
            ;;
        update)
            update_packages
            ;;
        remove)
            remove_packages
            ;;
        remove-unused)
            remove_unused_packages
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
