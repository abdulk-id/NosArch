#!/usr/bin/env bash

set -euo pipefail

_ensure_command() {
    if ! command -v "$1" &>/dev/null; then
        echo "Error: $1 is required but not found."
        exit 1
    fi
}

# --- Dependencies ---
for cmd in gum fzf yay; do
    _ensure_command "$cmd"
done

# --- Helper functions ---
# Shared fzf runner
run_fzf() {
    local source_cmd="$1"
    local preview_cmd="$2"
    local pointer_color="$3"
    local preview_label="$4"

    shift 4

    local extra_binds=("$@")

    local fzf_args=(
        --multi

        --preview "$preview_cmd"

        --preview-label="$preview_label"
        --preview-label-pos='bottom'

        --preview-window 'down:65%:wrap'

        --bind 'alt-p:toggle-preview'
        --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
        --bind 'alt-k:preview-up,alt-j:preview-down'
        --bind 'alt-c:abort'

        --color "pointer:$pointer_color,marker:$pointer_color"

        "${extra_binds[@]}"
    )

    eval "$source_cmd" | fzf "${fzf_args[@]}"
}

# Run command with status
run_command_with_status() {
    local cmd_to_run="$1"
    local run_message="$2"
    local success_message="$3"
    local fail_message="$4"

    gum style --foreground 2 --bold "$run_message"
    echo

    if eval "$cmd_to_run"; then
        echo
        gum style --foreground 2 "$success_message"
    else
        echo
        gum style --foreground 1 "$fail_message"
    fi
}

# --- Install packages ---
install_packages() {
    # Logic placed inside loop to:
    # - allow aborting the fzf tui and still return to the gum package source menu
    # - allow going back to the main menu by selecting "Go back"
    while true; do
        local source

        source=$(gum choose \
            --header "Select package source" \
            "Arch Repositories" \
            "AUR" \
            "← Go Back") || true

        [[ -z "$source" ]] && return 0

        case "$source" in
            "← Go Back")
                return 0
                ;;
        esac

        local source_cmd
        local preview_cmd
        local preview_label
        local install_message
        local pointer_color="green"

        local extra_binds=()

        case "$source" in
            "Arch Repositories")
                source_cmd="pacman -Slq"
                preview_cmd='pacman -Sii {1}'

                preview_label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select, alt-c: abort'
                install_message="▸ Installing packages..."

                install_cmd=(
                    sudo pacman -S --needed
                )
                ;;
            "AUR")
                source_cmd="yay -Slqa"
                preview_cmd='yay -Siia {1}'

                preview_label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll, tab: multi-select, alt-c: abort'
                extra_binds=(
                    --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
                    --bind 'alt-B:change-preview:yay -Siia {1}'
                )
                install_message="▸ Installing AUR packages..."

                install_cmd=(
                    yay -S
                )
                ;;
        esac

        pkg_names=$(
            run_fzf \
                "$source_cmd" \
                "$preview_cmd" \
                "$pointer_color" \
                "$preview_label" \
                "${extra_binds[@]}") || true

        # User pressed alt-c or esc
        [[ -z "$pkg_names" ]] && continue

        mapfile -t pkg_array <<< "$pkg_names"

        gum style --foreground 2 --bold "$install_message"
        echo

        if "${install_cmd[@]}" "${pkg_array[@]}"; then
            if command -v updatedb &>/dev/null; then
                sudo updatedb
            fi

            echo
            gum style --foreground 2 "✓ Installation complete!"
        else
            echo
            gum style --foreground 8 "x Installation failed."
        fi

        # Exit script after action performed
        status=$?
        exit $status
        # Explicitly exiting because otherwise script would return to the main menu
    done
}

# --- Remove packages ---
remove_packages() {
    # Logic placed inside loop to: allow aborting the fzf tui and still return to the main menu
    while true; do
        pkg_names=$(
            run_fzf \
                "yay -Qqe" \
                'yay -Qi {1}' \
                "red" \
                'alt-p: toggle description, alt-j/k: scroll, tab: multi-select, alt-c: abort'
        ) || true

        [[ -z "$pkg_names" ]] && return 0

        mapfile -t pkg_array <<< "$pkg_names"

        run_command_with_status \
            "sudo pacman -Rns ${pkg_array[*]}" \
            "▸ Removing packages..." \
            "✓ Packages removed!" \
            "x Removal failed."

        # Exit script after action performed
        status=$?
        exit $status
        # Explicitly exiting because otherwise script would return to the main menu
    done
}

# --- Update packages ---
update_packages() {
    run_command_with_status \
        "yay -Syu" \
        "▸ Updating packages..." \
        "✓ Updates installed!" \
        "x Update failed."

    # Exit script after action performed
    status=$?
    exit $status
    # Explicitly exiting because otherwise script would return to the main menu
}

# --- Remove unused (orphan) packages ---
remove_unused_packages() {
    run_command_with_status \
        "pacman -Qdtq | sudo pacman -Rns -" \
        "▸ Removing unused (orphan) packages..." \
        "✓ Unused packages removed!" \
        "x Removal failed."

    # Exit script after action performed
    status=$?
    exit $status
    # Explicitly exiting because otherwise script would return to the main menu
}

# --- Main menu ---
main() {
    while true; do
        action=$(gum choose \
            --header "Select action" \
            "Install Packages" \
            "Update Packages" \
            "Remove Packages" \
            "Remove Unused Packages" \
            "Exit")

        [[ -z "$action" ]] && exit 0

        case "$action" in
            "Install Packages")
                install_packages
                ;;
            "Update Packages")
                update_packages
                ;;
            "Remove Packages")
                remove_packages
                ;;
            "Remove Unused Packages")
                remove_unused_packages
                ;;
            "Exit")
                exit 0
                ;;
        esac
    done
}

main
