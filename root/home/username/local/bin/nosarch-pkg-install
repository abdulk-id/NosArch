#!/usr/bin/bash
# Show a fuzzy-finder TUI for picking new Arch packages to install.

_ensure_command() {
    if ! command -v "$1" &>/dev/null; then
        echo "Error: $1 is required but not installed."
        echo "Install it with: sudo pacman -S $1"
        exit 1
    fi
}

# --- Self-relaunch in floating terminal if not already in TUI window ---
CLASS="NosArch.Install-Arch-Package"
if [[ "${TUI_LAUNCHED}" != "1" ]]; then
    _ensure_command "hyprctl"
    _ensure_command "jq"

    # Check if a window with this specific class is already running
    ADDR=$(hyprctl clients -j | jq -r ".[] | select(.class == \"$CLASS\") | .address" | head -n 1)

    if [[ -n "$ADDR" && "$ADDR" != "null" ]]; then
        hyprctl dispatch focuswindow address:"$ADDR"
    else
        CMD_WRAPPER="bash -c \"if ! TUI_LAUNCHED=1 bash '$0'; then echo -e '\nProcess failed'; fi; echo 'Press any key to exit...'; read -n 1 -s -r\""
        RULES="float on; size 1280 720; center 1"
        hyprctl dispatch exec "[$RULES] xdg-terminal-exec --class=$CLASS -e $CMD_WRAPPER"
    fi
    exit 0
fi

# --- TUI (running inside the floating terminal) ---
_ensure_command "gum"
_ensure_command "fzf"

fzf_args=(
  --multi
  --preview 'pacman -Sii {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

# List all packages from official repos (names only)
pkg_names=$(pacman -Slq | fzf "${fzf_args[@]}")

if [[ -n "$pkg_names" ]]; then
    pkgs_to_install=$(echo "$pkg_names" | xargs)

    gum style --foreground 2 --bold "▸ Installing packages..."

    if sudo pacman -S --needed $pkgs_to_install; then
        if command -v updatedb &>/dev/null; then
            sudo updatedb
        fi

        echo
        gum style --foreground 2 "✓ Installation complete!"
    else
        echo
        gum style --foreground 8 "Installation failed."
    fi
fi
