#!/usr/bin/bash

UNIT="nosarch-idle-inhibit.service"

if systemctl --user is-active --quiet "$UNIT"; then
    systemctl --user stop "$UNIT"
    notify-send -a "NosArch Power" -u low "󱫖  Toggle Idling Off" "Now locking computer when idle"
else
    systemd-run --user \
        --unit=nosarch-idle-inhibit \
        --description="NosArch Idle Inhibition (Manual Toggle)" \
        /usr/bin/systemd-inhibit --what=idle --who="Manual Toggle" --why="User requested" sleep infinity

    notify-send -a "NosArch Power" -u low "󱫖  Toggle Idling On" "Stop locking computer when idle"
fi
