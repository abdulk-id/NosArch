_cmd_screenshot() {
    _require_running
    dir=$(_instance_dir)
    target=${1:-"${dir}/screenshot.png"}
    case "$target" in
        /*) ;;
        *) target="$(pwd)/${target}" ;;
    esac
    _qmp "$dir" "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\"${target}\",\"format\":\"png\"}}"
    printf '%s\n' "$target"
}

# Maps one typed character to the QEMU key codes that produce it, a space-separated list ending in the key itself.
_key_codes() {
    case "$1" in
        [a-z0-9]) printf '%s' "$1" ;;
        [A-Z]) printf 'shift %s' "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" ;;
        ' ') printf 'spc' ;;
        '-') printf 'minus' ;;
        '_') printf 'shift minus' ;;
        '=') printf 'equal' ;;
        '+') printf 'shift equal' ;;
        '.') printf 'dot' ;;
        ',') printf 'comma' ;;
        '/') printf 'slash' ;;
        ':') printf 'shift semicolon' ;;
        ';') printf 'semicolon' ;;
        '!') printf 'shift 1' ;;
        '@') printf 'shift 2' ;;
        '#') printf 'shift 3' ;;
        *) return 1 ;;
    esac
}

# Builds the QMP send-key command for a space-separated list of key codes.
_send_key_command() {
    keys=
    for code in $1; do
        keys="${keys}${keys:+,}{\"type\":\"qcode\",\"data\":\"${code}\"}"
    done
    printf '{"execute":"send-key","arguments":{"keys":[%s]}}' "$keys"
}

_cmd_type() {
    _require_running
    [ "$#" -ge 1 ] || _die "Usage: vm type TEXT"
    text="$*"

    commands=
    while [ -n "$text" ]; do
        rest=${text#?}
        char=${text%"$rest"}
        text=$rest
        codes=$(_key_codes "$char") || _die "Cannot type the character '${char}'. Use 'vm key' for special keys."
        commands="${commands}$(_send_key_command "$codes")
"
    done

    # One command per line, each as its own argument, because QMP answers them one by one.
    old_ifs=$IFS
    IFS='
'
    set -f
    # shellcheck disable=SC2086
    _qmp "$(_instance_dir)" $commands
    set +f
    IFS=$old_ifs
}

_cmd_key() {
    _require_running
    [ "$#" -ge 1 ] || _die "Usage: vm key KEY..."
    for combination in "$@"; do
        # "ctrl-alt-f3" presses the three keys together.
        _qmp "$(_instance_dir)" "$(_send_key_command "$(printf '%s' "$combination" | tr '-' ' ')")"
    done
}

_cmd_login() {
    _require_running
    _wait_until 120 _ssh "root@nosarch" systemctl is-active --quiet sddm ||
        _die "SDDM is not running. It only starts after an apply and a reboot."
    # The greeter takes a few seconds to draw after the service is up.
    sleep 8
    _cmd_type "$VM_PASSWORD"
    _cmd_key ret
    _info "Logged in as ${VM_USER}. The desktop takes about 20 seconds to appear, see 'vm screenshot'."
}

_cmd_console() {
    log="$(_instance_dir)/serial.log"
    [ -f "$log" ] || _die "Instance '${INSTANCE_NAME}' has no console log yet."
    cat "$log"
}

