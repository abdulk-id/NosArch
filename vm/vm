main() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                [ "$#" -ge 2 ] || _die "--name needs a value."
                INSTANCE_NAME=$2
                shift 2
                ;;
            help | -h | --help)
                show_help
                return
                ;;
            *) break ;;
        esac
    done

    [ "$#" -gt 0 ] || {
        show_help
        return 1
    }

    _validate_name
    command_name=$1
    shift

    case "$command_name" in
        create) _cmd_create "$@" ;;
        start) _cmd_start "$@" ;;
        stop) _cmd_stop ;;
        reboot) _cmd_reboot ;;
        reset) _cmd_reset "$@" ;;
        destroy) _cmd_destroy ;;
        status) _cmd_status ;;
        list) _cmd_list ;;
        checkpoint) _cmd_checkpoint "$@" ;;
        restore) _cmd_restore "$@" ;;
        ssh) _cmd_ssh "$@" ;;
        sync) _cmd_sync ;;
        apply) _cmd_apply "$@" ;;
        screenshot) _cmd_screenshot "$@" ;;
        login) _cmd_login ;;
        type) _cmd_type "$@" ;;
        key) _cmd_key "$@" ;;
        console) _cmd_console ;;
        *) _die "Unknown command '${command_name}'. Run 'vm help'." ;;
    esac
}

main "$@"
